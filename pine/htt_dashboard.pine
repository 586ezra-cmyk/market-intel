//@version=6
indicator("HTT דשבורד — המשקפיים של חי טל", "HTTD", overlay=false, max_lines_count=50, max_labels_count=50)

// ─── מתגים ───────────────────────────────────────────────────────────────────
gM = "מודולים"
mFly  = input.bool(true,  "טיסה לונג+שורט",        group=gM)
mWing = input.bool(true,  "שבירת כנף",             group=gM)
mOB   = input.bool(true,  "אורדר בלוק",            group=gM)
mWM   = input.bool(true,  "W/M + דאבל",             group=gM)
mMC   = input.bool(false, "מונטה קרלו",            group=gM)
mFVG  = input.bool(true,  "FVG / iFVG",            group=gM)
mSMT  = input.bool(true,  "SMT / iSMT (צמד קבוע של הקורס)", group=gM)
mPOC  = input.bool(true,  "ריטסט POC (P) — ווליום פרופייל", group=gM)
mLiq  = input.bool(true,  "נזילות + Judas",        group=gM)

g0 = "ליבה"
pivLen  = input.int(5, "אורך פיבוט", minval=2, group=g0)
volLook = input.int(250, "חלון אחוזון ווליום", minval=50, group=g0)
climaxP = input.int(95, "קליימקס — אחוזון", minval=80, maxval=99, group=g0)
lowVolP = input.int(15, "ווליום נמוך — אחוזון", minval=1, maxval=30, group=g0)
cVolK   = input.float(0.8, "C: יחס ווליום מ-A", minval=0.3, step=0.1, group=g0)
tolAtr  = input.float(0.25, "טולרנס שוויון (ATR)", minval=0.05, step=0.05, group=g0)
obDepth = input.float(21.0, "OB: עומק כניסה באזור %", minval=0, maxval=100, step=1, group=g0)
flyStrict = input.bool(false, "טיסה קפדנית — רק בפאזה D (הקורס); כבוי = C או D", group=g0)
rsiLen = input.int(14, "RSI: אורך (הקורס: הרגיל)", minval=2, group=g0)
rsiHi = input.int(70, "RSI: רמה גבוהה", minval=50, maxval=95, group=g0)
rsiLo = input.int(30, "RSI: רמה נמוכה", minval=5, maxval=50, group=g0)
sqBars  = input.int(8, "אורך התכווצות", minval=4, group=g0)
sqAtrK  = input.float(2.5, "רוחב התכווצות (ATR)", minval=0.5, step=0.5, group=g0)
targetR = input.float(3.0, "יעד בדיקה (R)", minval=0.5, step=0.5, group=g0)
stopBuf = input.float(0.1, "מרווח סטופ %", minval=0.0, step=0.05, group=g0)
emaLen = input.int(12, "EMA — אישור כיוון: מעל/מתחת + שיפוע (המשתמש 22.10)", minval=2, group=g0)

gS = "סשנים (שעון ישראל)"
sesAsia = input.session("0200-1000", "אסיה", group=gS)
sesLon  = input.session("1000-1800", "לונדון", group=gS)
sesNY   = input.session("1800-0100", "ניו יורק", group=gS)
orMin   = input.int(15, "טווח פתיחה (דקות)", minval=5, group=gS)

gVP = "ווליום פרופייל (המחקר 19)"
vpOn = input.bool(true, "לחשב: POC היום, אזור ערך (VAH/VAL), nPOC, אזורי עיגון", group=gVP)
vpBins = input.int(120, "רזולוציה — תאי מחיר ל-ATR יומי", minval=30, maxval=400, group=gVP)
vpVA = input.float(70, "אזור ערך — % מהווליום", minval=50, maxval=90, step=5, group=gVP)
vpMinBars = input.int(12, "POC היום תקף אחרי N נרות", minval=1, maxval=200, group=gVP)
pocLeaveAtr = input.float(1.0, "ריטסט POC — המחיר יצא מהערך לפחות X ATR ב-10 הנרות שלפני החזרה", minval=0.0, step=0.25, group=gVP)
pocTolAtr = input.float(0.35, "ריטסט POC / 'על ה-POC' — מרחק (ATR)", minval=0.05, step=0.05, group=gVP)
zBarsN = input.int(300, "אזורי עיגון: חלון חישוב (נרות)", minval=50, maxval=1500, group=gVP)
zEvery = input.int(20, "אזורי עיגון: חישוב מחדש כל N נרות", minval=1, maxval=200, group=gVP)
zHalf = input.float(0.5, "אזורי עיגון: רוחב = תאים עם ווליום ≥ X מהשיא", minval=0.2, maxval=0.9, step=0.05, group=gVP)

gW = "חיבור"
secret = input.string("dev-secret", "Secret", group=gW)
asset2Mode = input.string("אוטומטי", "נכס מתואם (SMT)", options=["אוטומטי", "ידני"], group=gW)
asset2Man = input.symbol("BINANCE:BTCUSDT", "נכס ידני (רק במצב ידני)", group=gW)

gB = "בקטסט"
btSel = input.string("הכול", "אסטרטגיה לבדיקה", options=["הכול", "טיסה", "כנף", "אורדר בלוק", "W/M", "ריטסט POC"], group=gB)
btUseRange = input.bool(false, "הגבל לטווח תאריכים", group=gB)
btFrom = input.time(timestamp("01 Jan 2026 00:00 +0300"), "מתאריך", group=gB)
btTo = input.time(timestamp("31 Dec 2026 23:59 +0300"), "עד תאריך", group=gB)
btPeriod = input.string("הכול", "תקופה אחרונה (לחיצה אחת)", options=["הכול", "7 ימים", "30 יום", "90 יום", "365 יום"], group=gB)

gT = "טבלה"
tblPosS = input.string("תחתון-שמאל", "מיקום", options=["מרכז", "עליון-מרכז", "תחתון-מרכז", "שמאל-מרכז", "ימין-מרכז", "עליון-שמאל", "עליון-ימין", "תחתון-שמאל", "תחתון-ימין"], group=gT)
tblSizeS = input.string("קטן", "גודל טקסט", options=["זעיר", "קטן", "רגיל", "גדול"], group=gT)
tblCompact = input.bool(false, "מצב קומפקטי — רק מטריצה ובקטסט", group=gT)
tblLayoutS = input.string("רחב", "פריסה", options=["רחב", "טלפון"], group=gT)
tblLayout = tblLayoutS == "טלפון" ? "טלפון" : "רחב"
tblShiftX = input.int(0, "הזזה אופקית (+ ימינה / − שמאלה)", minval=-12, maxval=12, group=gT)
tblShiftY = input.int(0, "הזזה אנכית (+ למטה / − למעלה)", minval=-12, maxval=12, group=gT)

// ─── בסיס ────────────────────────────────────────────────────────────────────
atr = ta.atr(14)
volRank = ta.percentrank(volume, volLook)
volClimax = volRank >= climaxP
volLow    = volRank <= lowVolP
tol = atr * tolAtr
tfMin = timeframe.in_seconds() / 60
btDays = btPeriod == "7 ימים" ? 7 : btPeriod == "30 יום" ? 30 : btPeriod == "90 יום" ? 90 : btPeriod == "365 יום" ? 365 : 0
inBT = (not btUseRange or (time >= btFrom and time <= btTo)) and (btDays == 0 or time >= last_bar_time - btDays * 86400000)
btFly = btSel == "הכול" or btSel == "טיסה"
btWing = btSel == "הכול" or btSel == "כנף"
btOB = btSel == "הכול" or btSel == "אורדר בלוק"
btWM = btSel == "הכול" or btSel == "W/M"
btPOC = btSel == "הכול" or btSel == "ריטסט POC"

ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low,  pivLen, pivLen)
var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na
var int lastPHi = na
var int prevPHi = na
var int lastPLi = na
var int prevPLi = na
if not na(ph)
    prevPH := lastPH
    prevPHi := lastPHi
    lastPH := ph
    lastPHi := bar_index - pivLen
if not na(pl)
    prevPL := lastPL
    prevPLi := lastPLi
    lastPL := pl
    lastPLi := bar_index - pivLen

xUpPH = ta.crossover(close, lastPH)
xDnPL = ta.crossunder(close, lastPL)
bosUp = not na(lastPH) and xUpPH
bosDn = not na(lastPL) and xDnPL
var int msDir = 0
chochUp = bosUp and msDir < 0
chochDn = bosDn and msDir > 0
if bosUp
    msDir := 1
if bosDn
    msDir := -1
// BOS לטיסה: רק נר 15 דקות ומעלה שסוגר מעבר לרמה (10-4). בגרף קטן — סגירת בלוק 15m
ch15 = ta.change(time("15"))
is15New = tfMin < 15 and nz(ch15, 0) != 0
var float c15a = na
var float c15b = na
if is15New
    c15b := c15a
    c15a := close[1]
bos15Up = not na(c15b) and not na(lastPH) and c15a > lastPH and c15b <= lastPH
bos15Dn = not na(c15b) and not na(lastPL) and c15a < lastPL and c15b >= lastPL
bosUpF = tfMin >= 15 ? bosUp : bos15Up
bosDnF = tfMin >= 15 ? bosDn : bos15Dn

// ─── וויקוף — לפי הקורס: A = קליימקס (SC/BC) → AR (33-10) · B = ST + איסוף נזילות · C = ניעור (ספרינג/UT) + טסט · D = תפיסת כיוון = ה-BOS הראשון אחרי C (48-1) · E = יציאה לדרך מעבר לקריק/אייס (41-5)
var int phase = 0
var int procDir = 0
var float aVol = na
var float rHi = na
var float rLo = na
var int aBar = na
var int bBar = na
var int cBar = na
var int dBar = na
var int eBar = na
var bool cIsBull = false
var float cExt = na
var bool testOK = false
var float cVolC = na
var bool noC = false
var bool cByVol = false
var bool cDirOpen = false
var float vcHi = na
var float vcLo = na
var int swpBar = na
var int cStartBar = na
var float swpOpp = na
var float cOpp = na
var float eExt = na
var float eOpp = na
var int aExtBar = na
lo30 = ta.lowest(low, 30)
hi30 = ta.highest(high, 30)
// קליימקס בקצה של מגמה: SC = ווליום קיצוני בשפל 30 נרות אחרי ירידה; BC = בשיא אחרי עלייה. קליימקס באמצע תנועה אינו A
scBar = volClimax and low <= lo30 and close[20] - close >= atr
bcBar = volClimax and high >= hi30 and close - close[20] >= atr
rngH = nz(rHi - rLo, 0)
// A → B: הריאקציה האוטומטית (AR) = הפיבוט הראשון נגד הקליימקס — מגדיר את הקריק (איסוף) / האייס (פיזור). "איך סימנת אייס וקריק אם לא היה AR?" (48-1)
if phase == 1
    if procDir == -1
        if high > rHi
            rHi := high
            aExtBar := bar_index
            rLo := float(na)
        else
            rLo := na(rLo) ? low : math.min(rLo, low)
    else
        if low < rLo
            rLo := low
            aExtBar := bar_index
            rHi := float(na)
        else
            rHi := na(rHi) ? high : math.max(rHi, high)
    arNow = procDir == 1 ? (not na(ph) and bar_index - pivLen > aExtBar) : (not na(pl) and bar_index - pivLen > aExtBar)
    if arNow
        phase := 2
        bBar := bar_index
    else if bar_index - aBar > 40
        phase := 0
// B: ניעורים משני הצדדים (33-10). ספרינג/UT = יציאה מהגבול בווליום גבוה וסגירה חזרה (רב-נרות). פריצה בלי C בכיוון התהליך = איסוף/פיזור חוזר → E (48-1: "איסוף חוזר לא מחייב C")
var int swpDir = 0
var float swpExt = na
var float swpVol = na
var float swpRank = na
spring = false
utSig = false
if phase == 2 or phase == 3 or phase == 4
    if swpDir == 0 and low < rLo
        swpDir := 1
        swpBar := bar_index
        swpOpp := high
        swpExt := low
        swpVol := volume
        swpRank := volRank
    else if swpDir == 0 and high > rHi
        swpDir := -1
        swpBar := bar_index
        swpOpp := low
        swpExt := high
        swpVol := volume
        swpRank := volRank
    else if swpDir == 1
        if low < swpExt
            swpExt := low
            swpOpp := high
        swpVol := math.max(swpVol, volume)
        swpRank := math.max(swpRank, volRank)
        if close > rLo
            if (phase == 3 and not cDirOpen and cIsBull) or swpVol >= aVol * cVolK or swpRank >= climaxP
                spring := true
            swpDir := 0
        else if close < rLo - rngH * 0.25 or bar_index - swpBar > 20
            noC := not (phase >= 3 and not cIsBull)
            phase := 5
            cIsBull := false
            eExt := swpExt
            eOpp := swpOpp
            eBar := bar_index
            swpDir := 0
    else if swpDir == -1
        if high > swpExt
            swpExt := high
            swpOpp := low
        swpVol := math.max(swpVol, volume)
        swpRank := math.max(swpRank, volRank)
        if close < rHi
            if (phase == 3 and not cDirOpen and not cIsBull) or swpVol >= aVol * cVolK or swpRank >= climaxP
                utSig := true
            swpDir := 0
        else if close > rHi + rngH * 0.25 or bar_index - swpBar > 20
            noC := not (phase >= 3 and cIsBull)
            phase := 5
            cIsBull := true
            eExt := swpExt
            eOpp := swpOpp
            eBar := bar_index
            swpDir := 0
    if phase == 2 and bar_index - bBar > 200
        phase := 0
// ניעור נוסף באותו כיוון בזמן C = הרחבה של אותו ניעור (הקצה והנר הנגדי מתעדכנים, הקופסה לא זזה). ניעור מתוך D = C חדשה
cExtNow = false
if spring or utSig
    sameC = phase == 3 and not cDirOpen and cIsBull == spring
    cExtNow := sameC
    keepOld = sameC and not na(cExt) and (spring ? swpExt >= cExt : swpExt <= cExt)
    phase := 3
    cIsBull := spring
    cBar := bar_index
    cStartBar := sameC ? cStartBar : swpBar
    cExt := keepOld ? cExt : swpExt
    cOpp := keepOld ? cOpp : swpOpp
    cVolC := sameC ? math.max(nz(cVolC, swpVol), swpVol) : swpVol
    testOK := sameC ? testOK : false
    noC := false
    cByVol := false
    cDirOpen := false
// C לפי ווליום בלי ניעור: נר בווליום ≈ לקליימקס בתוך הטווח (22-8: "פאזה C שלאו דווקא יצאה מגבולות הגזרה, היה לה ווליום חזק"; 10-4: "B נמשכת כל עוד לא ראינו ווליום ≈ A").
// הכיוון לפי החצי של הטווח שבו הנר (חצי תחתון = ספיגה על האייס → לונג). ניעור שיבוא אחריו באותו כיוון = הרחבה של אותה C
volClx = swpDir == 0 and rngH > 0 and low >= rLo and high <= rHi and not (spring or utSig) and (volume >= aVol * cVolK or volRank >= climaxP)
volC = volClx and phase == 2
if volC
    phase := 3
    cByVol := true
    cDirOpen := true
    cBar := bar_index
    cStartBar := bar_index
    vcHi := high
    vcLo := low
    cExt := float(na)
    cOpp := float(na)
    cVolC := volume
    testOK := false
    noC := false
else if phase == 3 and cDirOpen and volClx
    vcHi := math.max(vcHi, high)
    vcLo := math.min(vcLo, low)
    cVolC := math.max(cVolC, volume)
// הכיוון של C ווליום נקבע לפי ה-LPS (10-5: "ווליום גבוה, התכווצות, LPS, פריצה"): שפל גבוה יותר שנשמר מעל נר הווליום בווליום נמוך = LPS → לונג;
// שיא נמוך יותר מתחת לנר בווליום נמוך = LPSY → שורט. סגירה מעבר לנר לפני זה = ה-BOS הראשון נותן כיוון (48-1). אין טיימאאוט: ה-LPS יכול להיבנות לאט (המשתמש 8/9)
volDirUp = false
volDirDn = false
if phase == 3 and cDirOpen
    lpsUp = not na(pl) and bar_index - pivLen > cBar and pl > vcLo and pl < vcHi and volume[pivLen] < cVolC
    lpsDn = not na(ph) and bar_index - pivLen > cBar and ph < vcHi and ph > vcLo and volume[pivLen] < cVolC
    if close > vcHi or (lpsUp and not lpsDn)
        cIsBull := true
        cDirOpen := false
        cExt := vcLo
        cOpp := vcHi
        volDirUp := true
    else if close < vcLo or (lpsDn and not lpsUp)
        cIsBull := false
        cDirOpen := false
        cExt := vcHi
        cOpp := vcLo
        volDirDn := true
// LPS/LPSY בכל C וגם ב-D (המשתמש 9/9: "בכל מקרה בפאזה C"; 10-3: "ברגע שיצאנו לפאזה D כל LPS זה תהליך איסוף"): אחרי C עם כיוון — שפל בווליום נמוך שנשמר מעל קצה הניעור = LPS (10-5: "התכווצות, LPS, פריצה");
// שיא בווליום נמוך מתחת לקצה ה-UT = LPSY. נספר גם כטסט (חזרה בווליום נמוך, 22-4)
lpsMark = false
lpsyMark = false
if (phase == 3 or phase == 4) and not cDirOpen and not na(cExt)
    if cIsBull and not na(pl) and bar_index - pivLen > cBar and pl > cExt and volume[pivLen] < nz(cVolC, volume[pivLen] + 1)
        lpsMark := true
        testOK := true
    if not cIsBull and not na(ph) and bar_index - pivLen > cBar and ph < cExt and volume[pivLen] < nz(cVolC, volume[pivLen] + 1)
        lpsyMark := true
        testOK := true
// טסט: חזרה לאזור הניעור בווליום נמוך — ההיצע התייבש (22-4)
if (phase == 3 or phase == 4) and cIsBull and low <= cExt + tol and low >= cExt - tol * 2 and volLow
    testOK := true
if (phase == 3 or phase == 4) and not cIsBull and high >= cExt - tol and high <= cExt + tol * 2 and volLow
    testOK := true
// C → D: תפיסת כיוון = ה-BOS הראשון בכיוון ההכרעה ("יש צ'וץ' → מחכים לבוס. BOS ראשון נותן כיוון", 48-1)
if phase == 3 and not cDirOpen and (cIsBull ? (bosUp or close > cOpp) : (bosDn or close < cOpp))
    phase := 4
    dBar := bar_index
// הניעור נכשל: סגירה מעבר לקצה שלו → "כשצד אחד נכשל הצד השני מנסה" (חזרה ל-B); מעבר ל-25% מגובה הטווח → הטווח נשבר
// הניעור נכשל: סגירה מעבר לקצה שלו = הצד השני ניצח ("כשצד אחד נכשל הצד השני מנסה") → הסגירה הזאת היא ה-BOS של הצד השני → D הפוכה.
// מעבר ל-25% מגובה הטווח = הטווח נשבר → E
if (phase == 3 or phase == 4) and swpDir == 0 and (cIsBull ? close < cExt : close > cExt)
    brk = cIsBull ? close < rLo - rngH * 0.25 : close > rHi + rngH * 0.25
    cIsBull := not cIsBull
    if brk
        phase := 5
        eBar := bar_index
        noC := true
        eExt := cIsBull ? high : low
        eOpp := cIsBull ? low : high
    else
        phase := 4
        dBar := bar_index
        cBar := bar_index
        cOpp := cIsBull ? low : high
        cExt := cIsBull ? nz(lastPL, low) : nz(lastPH, high)
        testOK := false
    swpDir := 0
// D → E: יציאה לדרך = סגירה מעבר לקריק (איסוף) / מתחת לאייס (פיזור). "המרקאפ יוצא לדרך רק אחרי שסיימנו את הקריק" (41-5)
eBrk = cIsBull ? (close > rHi + rngH * 0.25 or (close > rHi and close[1] > rHi and low > rHi)) : (close < rLo - rngH * 0.25 or (close < rLo and close[1] < rLo and high < rLo))
if phase == 4 and eBrk
    phase := 5
    eBar := bar_index
    eExt := cIsBull ? high : low
    eOpp := cIsBull ? low : high
    swpDir := 0
if phase == 4 and bar_index - dBar > 60
    phase := 3
    cBar := bar_index
    cStartBar := bar_index
    swpDir := 0
// E: ניהול בלבד. מתאפס אחרי 100 נרות בלי תהליך חדש
if phase == 5 and bar_index - eBar > 100
    phase := 0
if phase == 5 and (na(eExt) or (cIsBull ? high > eExt : low < eExt))
    eExt := cIsBull ? high : low
    eOpp := cIsBull ? low : high
// פריצה שחזרה לתוך הטווח תוך 20 נרות = פריצת שווא (ניעור מהצד הזה), לא יציאה לדרך → C בכיוון ההפוך
if phase == 5 and bar_index - eBar <= 20 and (cIsBull ? close < rHi : close > rLo)
    cIsBull := not cIsBull
    cExt := eExt
    cOpp := nz(eOpp, cIsBull ? high : low)
    cBar := bar_index
    cStartBar := eBar
    phase := 3
    swpDir := 0
    noC := false
// A נפתחת רק בקליימקס בקצה מגמה. "וויקוף לא מנחשים מפאזה A — בונים אחרי C" (48-1): A/B מוצגות, לא נסחרות
if (scBar or bcBar) and (phase == 0 or ((phase == 5 and bar_index - eBar > 20 or phase == 2) and (bcBar ? high > rHi + rngH * 0.25 : low < rLo - rngH * 0.25)))
    phase := 1
    procDir := scBar ? 1 : -1
    aVol := volume
    aBar := bar_index
    aExtBar := bar_index
    rHi := scBar ? float(na) : high
    rLo := scBar ? low : float(na)
    swpDir := 0
    testOK := false
    noC := false
inMid = phase > 0 and not na(rHi) and close < rHi - (rHi - rLo) * 0.2 and close > rLo + (rHi - rLo) * 0.2
var float flipPx = na
var int flipBar = na
xDnRLo = ta.crossunder(close, rLo)
xUpRHi = ta.crossover(close, rHi)
if phase > 0 and not na(rLo) and xDnRLo
    flipPx := rLo
    flipBar := bar_index
if phase > 0 and not na(rHi) and xUpRHi
    flipPx := rHi
    flipBar := bar_index

// ─── סשנים + AMD + Judas ────────────────────────────────────────────────────
inAsia = not na(time(timeframe.period, sesAsia, "Asia/Jerusalem"))
inLon  = not na(time(timeframe.period, sesLon,  "Asia/Jerusalem"))
inNY   = not na(time(timeframe.period, sesNY,   "Asia/Jerusalem"))
sesIdx = inLon ? 1 : inNY ? 2 : inAsia ? 0 : 3
sesName = sesIdx == 0 ? "אסיה" : sesIdx == 1 ? "לונדון" : sesIdx == 2 ? "ניו-יורק" : "מחוץ"
dayName = dayofweek == dayofweek.sunday ? "א" : dayofweek == dayofweek.monday ? "ב" : dayofweek == dayofweek.tuesday ? "ג" : dayofweek == dayofweek.wednesday ? "ד" : dayofweek == dayofweek.thursday ? "ה" : dayofweek == dayofweek.friday ? "ו" : "ש"
sesNew = sesIdx != sesIdx[1]
var float orH = na
var float orL = na
var int orStart = na
var float prevSesH = na
var float prevSesL = na
var float curSesH = na
var float curSesL = na
if sesNew
    prevSesH := curSesH
    prevSesL := curSesL
    curSesH := high
    curSesL := low
    orH := high
    orL := low
    orStart := bar_index
else
    curSesH := math.max(nz(curSesH, high), high)
    curSesL := math.min(nz(curSesL, low), low)
orBars = math.max(1, math.round(orMin * 60 / timeframe.in_seconds()))
inOR = not na(orStart) and bar_index - orStart < orBars
if inOR and not sesNew
    orH := math.max(orH, high)
    orL := math.min(orL, low)
judasBull = mLiq and not inOR and not na(orL) and low < orL and close > orL and close > open
judasBear = mLiq and not inOR and not na(orH) and high > orH and close < orH and close < open
var string amdPh = "A"
if sesNew
    amdPh := "A"
if judasBull or judasBear
    amdPh := "M"
if amdPh == "M" and (bosUp or bosDn)
    amdPh := "D"

// ─── נזילות: בריכות + Sweep ──────────────────────────────────────────────────
eqHi = not na(ph) and not na(prevPH) and math.abs(ph - prevPH) <= tol
eqLo = not na(pl) and not na(prevPL) and math.abs(pl - prevPL) <= tol
var float poolHi = na
var float poolLo = na
if mLiq and eqHi
    poolHi := (ph + prevPH) / 2
if mLiq and eqLo
    poolLo := (pl + prevPL) / 2
sweepHi = mLiq and not na(poolHi) and high > poolHi and close < poolHi
sweepLo = mLiq and not na(poolLo) and low < poolLo and close > poolLo

// ─── Premium / Discount ──────────────────────────────────────────────────────
hi100 = ta.highest(high, 100)
lo100 = ta.lowest(low, 100)
pdHi = phase > 0 ? rHi : hi100
pdLo = phase > 0 ? rLo : lo100
pdMid = (pdHi + pdLo) / 2
inPrem = close > pdMid
pdPct = pdHi != pdLo ? math.round((close - pdLo) / (pdHi - pdLo) * 100) : 50

// ─── FVG (גופים) + iFVG ─────────────────────────────────────────────────────
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
// FVG (ICT): פתיל נר 1 → פתיל נר 3; נר 2 = דחף ≥ 1.2 ATR; מרווח ≥ 0.5 ATR
pBodyTop = high[2]
pBodyBot = low[2]
dispOK = high[1] - low[1] >= atr * 1.2
bullGap = dispOK and low - pBodyTop >= atr * 0.5 and low > pBodyTop
bearGap = dispOK and pBodyBot - high >= atr * 0.5 and high < pBodyBot
var float bgTop = na
var float bgBot = na
var float sgTop = na
var float sgBot = na
var int bgState = 0
var int sgState = 0
if mFVG and bullGap
    bgTop := low
    bgBot := pBodyTop
    bgState := 1
if mFVG and bearGap
    sgTop := pBodyBot
    sgBot := high
    sgState := 1
if bgState == 1 and low <= bgBot
    bgState := 2
if sgState == 1 and high >= sgTop
    sgState := 2
ifvgBear = bgState == 2 and close < bgBot and high >= bgBot and close < open
ifvgBull = sgState == 2 and close > sgTop and low <= sgTop and close > open

// ─── SMT / iSMT ──────────────────────────────────────────────────────────────
// צמדי SMT קבועים: נאסדק↔S&P (CME), BTC↔ETH (Binance), כסף↔זהב (COMEX)
tk = syminfo.ticker
autoSym = str.contains(tk, "ETH") ? "BINANCE:BTCUSDT" : str.contains(tk, "BTC") ? "BINANCE:ETHUSDT" : str.contains(tk, "NQ") or str.contains(tk, "NAS") ? "CME_MINI:ES1!" : str.contains(tk, "ES") or str.contains(tk, "SPX") or str.contains(tk, "SPY") ? "CME_MINI:NQ1!" : str.contains(tk, "SI") or str.contains(tk, "XAG") or str.contains(tk, "SILVER") ? "COMEX:GC1!" : str.contains(tk, "GC") or str.contains(tk, "XAU") or str.contains(tk, "GOLD") ? "COMEX:SI1!" : ""
// SMT רק לצמדים הקבועים של הקורס. נכס בלי צמד (USDT.D, SOL, אלטים, דומיננס) = בלי SMT בכלל
autoSymOk = autoSym != "" and not str.contains(tk, ".D")
smtOn = mSMT and (asset2Mode == "ידני" or autoSymOk)
smtSym = asset2Mode == "אוטומטי" ? (autoSymOk ? autoSym : syminfo.tickerid) : asset2Man
a2h = request.security(smtSym, timeframe.period, high, lookahead=barmerge.lookahead_off)
a2l = request.security(smtSym, timeframe.period, low, lookahead=barmerge.lookahead_off)
hi20 = ta.highest(high, 20)
lo20 = ta.lowest(low, 20)
a2hi20 = ta.highest(a2h, 20)
a2lo20 = ta.lowest(a2l, 20)
smtBear = smtOn and high >= hi20 and a2h < a2hi20 and barstate.isconfirmed
smtBull = smtOn and low <= lo20 and a2l > a2lo20 and barstate.isconfirmed
ismtBear = smtOn and high > high[1] and close < high[1] and not (a2h > a2h[1])
ismtBull = smtOn and low < low[1] and close > low[1] and not (a2l < a2l[1])

// ─── נר בולען ────────────────────────────────────────────────────────────────

// ─── טריגר: טיסה (לונג+שורט) ─────────────────────────────────────────────────
okZone = not inMid
armL34 = (phase == 3 or phase == 4) and cIsBull
armS34 = (phase == 3 or phase == 4) and not cIsBull
flyArmL = (flyStrict ? phase == 4 : (phase == 3 or phase == 4)) and cIsBull
flyArmS = (flyStrict ? phase == 4 : (phase == 3 or phase == 4)) and not cIsBull
flyLong  = mFly and flyArmL and okZone and bosUpF and barstate.isconfirmed
flyShort = mFly and flyArmS and okZone and bosDnF and barstate.isconfirmed

// ─── טריגר: שבירת כנף (שני כיוונים) ─────────────────────────────────────────
float wingUp = na
if not na(prevPL) and not na(lastPL) and lastPL > prevPL and lastPLi > prevPLi
    wingUp := lastPL + (lastPL - prevPL) / (lastPLi - prevPLi) * (bar_index - lastPLi)
float wingDn = na
if not na(prevPH) and not na(lastPH) and lastPH < prevPH and lastPHi > prevPHi
    wingDn := lastPH + (lastPH - prevPH) / (lastPHi - prevPHi) * (bar_index - lastPHi)
wingBrkS = not na(wingUp) and close < wingUp and close[1] >= nz(wingUp[1], wingUp)
wingBrkL = not na(wingDn) and close > wingDn and close[1] <= nz(wingDn[1], wingDn)
wingShort = mWing and armS34 and okZone and wingBrkS and barstate.isconfirmed
wingLong  = mWing and armL34 and okZone and wingBrkL and barstate.isconfirmed

// ─── טריגר: אורדר בלוק ──────────────────────────────────────────────────────
sqHi = ta.highest(high, sqBars)[1]
sqLo = ta.lowest(low, sqBars)[1]
isSq = (sqHi - sqLo) <= atr * sqAtrK
var float obLTop = na
var float obLBot = na
var float obSTop = na
var float obSBot = na
var bool obLLive = false
var bool obSLive = false
bool newObL = false
bool newObS = false
if mOB and bullGap and isSq[1] and close > nz(lastPH, high)
    obLTop := low
    obLBot := pBodyTop
    obLLive := true
    newObL := true
if mOB and bearGap and isSq[1] and close < nz(lastPL, low)
    obSTop := pBodyBot
    obSBot := high
    obSLive := true
    newObS := true
if obLLive and low <= obLBot
    obLLive := false
if obSLive and high >= obSTop
    obSLive := false
obLvlL = obLTop - (obLTop - obLBot) * obDepth / 100
obLvlS = obSBot + (obSTop - obSBot) * obDepth / 100
obLong  = mOB and obLLive and msDir >= 0 and low <= obLvlL and close > obLTop and barstate.isconfirmed
obShort = mOB and obSLive and msDir <= 0 and high >= obLvlS and close < obSBot and barstate.isconfirmed
if obLong
    obLLive := false
if obShort
    obSLive := false

// ─── טריגר: W/M + צבת ───────────────────────────────────────────────────────
var float wNeck = na
var float wLow2 = na
var int wState = 0
var float mNeck = na
var float mHigh2 = na
var int mState = 0
if mWM and not na(pl) and not na(prevPL) and not na(lastPHi) and lastPHi > prevPLi and math.abs(pl - prevPL) <= tol * 2
    wNeck := lastPH
    wLow2 := pl
    wState := 1
if mWM and not na(ph) and not na(prevPH) and not na(lastPLi) and lastPLi > prevPHi and math.abs(ph - prevPH) <= tol * 2
    mNeck := lastPL
    mHigh2 := ph
    mState := 1
xUpW = ta.crossover(close, wNeck)
xDnM = ta.crossunder(close, mNeck)
wSig = wState == 1 and not na(wNeck) and xUpW and barstate.isconfirmed
mSig = mState == 1 and not na(mNeck) and xDnM and barstate.isconfirmed
if wSig
    wState := 2
if mSig
    mState := 2

// ─── טריגר: מונטה קרלו ──────────────────────────────────────────────────────
var float legA = na
var float legB = na
var float legC = na
if not na(ph) and not na(lastPL) and ph > lastPL
    legC := legB
    legB := legA
    legA := (ph - lastPL) / lastPL * 100
mcAvg = not na(legA) ? (legA + nz(legB, legA) + nz(legC, nz(legB, legA))) / 3 : na
mcProj = mMC and not na(mcAvg) and not na(lastPL) ? lastPL * (1 + mcAvg / 100) : na
mcBrk = not na(lastPH) ? lastPH * 1.015 : na
var int mcHeld = 0
mcHeld := mMC and not na(mcBrk) and close > mcBrk ? mcHeld + 1 : 0

// ─── מד 4 הרמזים ────────────────────────────────────────────────────────────
var int lastClimaxBar = na
if volClimax
    lastClimaxBar := bar_index
clue1 = not na(lastClimaxBar) and bar_index - lastClimaxBar <= 60
var int bosUpCnt = 0
var int bosDnCnt = 0
if bosUp
    bosUpCnt += 1
    bosDnCnt := 0
if bosDn
    bosDnCnt += 1
    bosUpCnt := 0
clue2 = (msDir > 0 ? bosUpCnt : bosDnCnt) >= 2
clue3 = msDir > 0 ? close > close[10] and volRank < 50 : close < close[10] and volRank < 50
var bool flipHeld = false
if bosUp
    flipHeld := false
if msDir > 0 and not na(lastPH[1]) and low <= lastPH[1] + tol and close > lastPH[1]
    flipHeld := true
if msDir < 0 and not na(lastPL[1]) and high >= lastPL[1] - tol and close < lastPL[1]
    flipHeld := true
clue4 = flipHeld
clues = (clue1 ? 1 : 0) + (clue2 ? 1 : 0) + (clue3 ? 1 : 0) + (clue4 ? 1 : 0)

// ─── קונפלואנס ──────────────────────────────────────────────────────────────

// ─── EMA (אישור כיוון, המשתמש 22.10) ───────────────────────────────────────
ema12 = ta.ema(close, emaLen)
emaRising = ema12 > ema12[1]
ema12OkL = close > ema12 and emaRising
ema12OkS = close < ema12 and not emaRising

// ─── ווליום פרופייל של היום (כמו ב-HTT Master v56): POC מתפתח, VAH/VAL, nPOC, אזורי עיגון ───
dAtr = request.security(syminfo.tickerid, "D", ta.atr(14), lookahead=barmerge.lookahead_off)
newDay = nz(ta.change(time("D")), 0) != 0
f_binOf(float px, float b) => int(math.floor(px / b))
f_vpDay() =>
    var map<int, float> vpDay = map.new<int, float>()
    var float vpBin = na
    var int vpPocIdx = na
    var float vpPocVol = 0.0
    var float vpTot = 0.0
    var int vpDayN = 0
    var float[] npocArr = array.new<float>()
    var float prevPoc = na
    var float prevVah = na
    var float prevVal = na
    var float vah = na
    var float val = na
    float pocNow = na
    float npUp = na
    float npDn = na
    if vpOn
        if newDay or na(vpBin)
            if not na(vpPocIdx) and vpDayN >= vpMinBars
                prevPoc := (vpPocIdx + 0.5) * vpBin
                prevVah := vah
                prevVal := val
                array.unshift(npocArr, prevPoc)
                if array.size(npocArr) > 5
                    array.pop(npocArr)
            map.clear(vpDay)
            vpBin := math.max(syminfo.mintick, nz(dAtr, atr * 10) / vpBins)
            vpPocIdx := na
            vpPocVol := 0.0
            vpTot := 0.0
            vpDayN := 0
            vah := na
            val := na
        iLo = f_binOf(low, vpBin)
        nB = math.min(f_binOf(high, vpBin) - iLo + 1, 400)
        per = volume / nB
        for bi = iLo to iLo + nB - 1
            v = nz(map.get(vpDay, bi)) + per
            map.put(vpDay, bi, v)
            if v > vpPocVol
                vpPocVol := v
                vpPocIdx := bi
        vpTot += volume
        vpDayN += 1
        if not na(vpPocIdx) and vpTot > 0
            float acc = vpPocVol
            int up = vpPocIdx
            int dn = vpPocIdx
            float need = vpTot * vpVA / 100
            int guard = 0
            while acc < need and guard < 600
                vu = nz(map.get(vpDay, up + 1))
                vd = nz(map.get(vpDay, dn - 1))
                if vu >= vd
                    up += 1
                    acc += vu
                else
                    dn -= 1
                    acc += vd
                guard += 1
            vah := (up + 1) * vpBin
            val := dn * vpBin
        if vpDayN >= vpMinBars and not na(vpPocIdx)
            pocNow := (vpPocIdx + 0.5) * vpBin
        if array.size(npocArr) > 0
            for ni = array.size(npocArr) - 1 to 0
                nv = array.get(npocArr, ni)
                if low <= nv and high >= nv
                    array.remove(npocArr, ni)
        if array.size(npocArr) > 0
            for ni = 0 to array.size(npocArr) - 1
                nv = array.get(npocArr, ni)
                if nv > close and (na(npUp) or nv < npUp)
                    npUp := nv
                if nv < close and (na(npDn) or nv > npDn)
                    npDn := nv
    [pocNow, vah, val, prevPoc, prevVah, prevVal, npUp, npDn, vpDayN]
[pocNow, vah, val, prevPoc, prevVah, prevVal, npUp, npDn, vpDayN] = f_vpDay()
pocTol = atr * pocTolAtr
pocAtL = not na(pocNow) and low <= pocNow + pocTol and close > pocNow
pocAtS = not na(pocNow) and high >= pocNow - pocTol and close < pocNow
pocRising = not na(pocNow) and not na(pocNow[12]) and pocNow > pocNow[12]
pocFalling = not na(pocNow) and not na(pocNow[12]) and pocNow < pocNow[12]
// אזורי עיגון (HVN) — חישוב בלבד (הציור ב-HTT Master): שלושת צמתי הווליום ב-zBarsN הנרות האחרונים
f_zonesCalc(bool on) =>
    var float[] zTopA = array.new<float>(3, na)
    var float[] zBotA = array.new<float>(3, na)
    var float[] zPocA = array.new<float>(3, na)
    var map<int, float> vpZ = map.new<int, float>()
    if on and bar_index > zBarsN and (bar_index % zEvery == 0 or barstate.islast)
        map.clear(vpZ)
        zb = math.max(syminfo.mintick, nz(dAtr, atr * 10) / vpBins)
        for i = 0 to zBarsN - 1
            zlo = f_binOf(low[i], zb)
            znb = math.min(f_binOf(high[i], zb) - zlo + 1, 400)
            zper = volume[i] / znb
            for bi = zlo to zlo + znb - 1
                map.put(vpZ, bi, nz(map.get(vpZ, bi)) + zper)
        zkeys = map.keys(vpZ)
        for k = 0 to 2
            float best = 0.0
            int bestI = na
            for ki = 0 to array.size(zkeys) - 1
                kk = array.get(zkeys, ki)
                vv = nz(map.get(vpZ, kk))
                if vv > best
                    best := vv
                    bestI := kk
            if na(bestI) or best <= 0
                array.set(zTopA, k, na)
                array.set(zBotA, k, na)
                array.set(zPocA, k, na)
            else
                thr = best * zHalf
                int zu = bestI
                int zd = bestI
                while nz(map.get(vpZ, zu + 1)) >= thr and zu - bestI < 60
                    zu += 1
                while nz(map.get(vpZ, zd - 1)) >= thr and bestI - zd < 60
                    zd -= 1
                array.set(zTopA, k, (zu + 1) * zb)
                array.set(zBotA, k, zd * zb)
                array.set(zPocA, k, (bestI + 0.5) * zb)
                for bi = zd - 2 to zu + 2
                    map.put(vpZ, bi, 0.0)
    float zUp = na
    float zDn = na
    int zIn = 0
    for k = 0 to 2
        zp = array.get(zPocA, k)
        if on and not na(zp)
            if close >= array.get(zBotA, k) and close <= array.get(zTopA, k)
                zIn := k + 1
            if zp > close and (na(zUp) or zp < zUp)
                zUp := zp
            if zp < close and (na(zDn) or zp > zDn)
                zDn := zp
    [zUp, zDn, zIn, array.get(zPocA, 0), array.get(zPocA, 1), array.get(zPocA, 2)]
[zUp, zDn, zIn, zp1, zp2, zp3] = f_zonesCalc(vpOn)

// ─── טריגר: ריטסט POC (P) — אחרי BOS המחיר חזר ל-POC של היום, נגע וסגר חזרה בכיוון המבנה (המחקר 19) ───
pHi10 = ta.highest(high, 10)
pLo10 = ta.lowest(low, 10)
pWasUpN = ta.barssince(na(pocNow) or close <= pocNow)
pWasDnN = ta.barssince(na(pocNow) or close >= pocNow)
var int pocLastBar = na
pRtL0 = mPOC and not na(pocNow) and msDir > 0 and nz(pWasUpN[1], 999) >= 2 and nz(pHi10[1], high) >= pocNow + atr * pocLeaveAtr and low <= pocNow + pocTol and close > pocNow and barstate.isconfirmed
pRtS0 = mPOC and not na(pocNow) and msDir < 0 and nz(pWasDnN[1], 999) >= 2 and nz(pLo10[1], low) <= pocNow - atr * pocLeaveAtr and high >= pocNow - pocTol and close < pocNow and barstate.isconfirmed
pRtL = pRtL0 and (na(pocLastBar) or bar_index - pocLastBar > 5)
pRtS = pRtS0 and (na(pocLastBar) or bar_index - pocLastBar > 5)
if pRtL or pRtS
    pocLastBar := bar_index

// ─── מנוע בקטסט ─────────────────────────────────────────────────────────────
buf = stopBuf / 100.0
var int fN = 0
var int fW = 0
var int wN = 0
var int wW = 0
var int oN = 0
var int oW = 0
var int wmN = 0
var int wmW = 0
var int[] sesN = array.new_int(4, 0)
var int[] sesW = array.new_int(4, 0)
f_open(float stopPx, bool isLong) => isLong ? close + (close - stopPx) * targetR : close - (stopPx - close) * targetR
var int fSt = 0
var float fS = na
var float fT = na
var bool fL = true
var int fSes = 0
var int wSt = 0
var float wS = na
var float wT = na
var bool wL = true
var int wSes2 = 0
var int oSt = 0
var float oS = na
var float oT = na
var bool oL = true
var int oSes = 0
var int wmSt = 0
var float wmS = na
var float wmT = na
var bool wmL = true
var int wmSes = 0
if (flyLong or flyShort) and fSt == 0 and inBT and btFly
    fL := flyLong
    st = fL ? math.min(nz(cExt, low), nz(lastPL, low)) * (1 - buf) : math.max(nz(cExt, high), nz(lastPH, high)) * (1 + buf)
    ok = fL ? close > st : close < st
    if ok
        fSt := 1
        fS := st
        fT := f_open(st, fL)
        fN += 1
        fSes := sesIdx
        array.set(sesN, sesIdx, array.get(sesN, sesIdx) + 1)
if fSt == 1
    hitS = fL ? low <= fS : high >= fS
    hitT = fL ? high >= fT : low <= fT
    if hitS
        fSt := 0
    else if hitT
        fW += 1
        array.set(sesW, fSes, array.get(sesW, fSes) + 1)
        fSt := 0
if (wingShort or wingLong) and wSt == 0 and inBT and btWing
    wL := wingLong
    st = wL ? nz(lastPL, low) * (1 - buf) : nz(lastPH, high) * (1 + buf)
    ok = wL ? close > st : close < st
    if ok
        wSt := 1
        wS := st
        wT := f_open(st, wL)
        wN += 1
        wSes2 := sesIdx
        array.set(sesN, sesIdx, array.get(sesN, sesIdx) + 1)
if wSt == 1
    hitS = wL ? low <= wS : high >= wS
    hitT = wL ? high >= wT : low <= wT
    if hitS
        wSt := 0
    else if hitT
        wW += 1
        array.set(sesW, wSes2, array.get(sesW, wSes2) + 1)
        wSt := 0
if (obLong or obShort) and oSt == 0 and inBT and btOB
    oL := obLong
    st = oL ? obLBot * (1 - buf) : obSTop * (1 + buf)
    ok = oL ? close > st : close < st
    if ok
        oSt := 1
        oS := st
        oT := f_open(st, oL)
        oN += 1
        oSes := sesIdx
        array.set(sesN, sesIdx, array.get(sesN, sesIdx) + 1)
if oSt == 1
    hitS = oL ? low <= oS : high >= oS
    hitT = oL ? high >= oT : low <= oT
    if hitS
        oSt := 0
    else if hitT
        oW += 1
        array.set(sesW, oSes, array.get(sesW, oSes) + 1)
        oSt := 0
if (wSig or mSig) and wmSt == 0 and inBT and btWM
    wmL := wSig
    st = wmL ? nz(wLow2, low) * (1 - buf) : nz(mHigh2, high) * (1 + buf)
    ok = wmL ? close > st : close < st
    if ok
        wmSt := 1
        wmS := st
        wmT := f_open(st, wmL)
        wmN += 1
        wmSes := sesIdx
        array.set(sesN, sesIdx, array.get(sesN, sesIdx) + 1)
if wmSt == 1
    hitS = wmL ? low <= wmS : high >= wmS
    hitT = wmL ? high >= wmT : low <= wmT
    if hitS
        wmSt := 0
    else if hitT
        wmW += 1
        array.set(sesW, wmSes, array.get(sesW, wmSes) + 1)
        wmSt := 0

// ── P (ריטסט POC): סטופ מעבר ל-POC / לקצה נר הריטסט ──
f_pTrade(bool sigL, bool sigS) =>
    var int n = 0
    var int w = 0
    var int st = 0
    var float sp = na
    var float tp = na
    var bool isL = true
    var int ses = 0
    if (sigL or sigS) and st == 0
        isL := sigL
        stp = isL ? math.min(low, pocNow) * (1 - buf) : math.max(high, pocNow) * (1 + buf)
        if isL ? close > stp : close < stp
            st := 1
            sp := stp
            tp := f_open(stp, isL)
            n += 1
            ses := sesIdx
            array.set(sesN, sesIdx, array.get(sesN, sesIdx) + 1)
    if st == 1
        hitS = isL ? low <= sp : high >= sp
        hitT = isL ? high >= tp : low <= tp
        if hitS
            st := 0
        else if hitT
            w += 1
            array.set(sesW, ses, array.get(sesW, ses) + 1)
            st := 0
    [n, w, st, sp, tp, isL ? 1 : 0]
[pocN, pocW, pocSt, pocS, pocT, pocLi] = f_pTrade(pRtL and inBT and btPOC, pRtS and inBT and btPOC)
pocL = pocLi == 1
trigAgo = ta.barssince(flyLong or flyShort or wingLong or wingShort or obLong or obShort or wSig or mSig or pRtL or pRtS)
var string lastTrigNm = "—"
if flyLong or flyShort
    lastTrigNm := flyLong ? "✈ לונג" : "✈ שורט"
if wingLong or wingShort
    lastTrigNm := wingLong ? "כנף לונג" : "כנף שורט"
if obLong or obShort
    lastTrigNm := obLong ? "OB לונג" : "OB שורט"
if wSig or mSig
    lastTrigNm := wSig ? "W✓" : "M✓"
if pRtL or pRtS
    lastTrigNm := pRtL ? "P לונג" : "P שורט"

// ─── צ'ק-ליסט ────────────────────────────────────────────────────────────────
ckSpring = (phase == 3 or phase == 4) and cIsBull
ckUT = (phase == 3 or phase == 4) and not cIsBull
ckTest = testOK
ckSes = sesIdx != 3
armDir = ckSpring ? 1 : ckUT ? -1 : 0
float ckStop = armDir == 1 ? math.min(nz(cExt, low), nz(lastPL, low)) : armDir == -1 ? math.max(nz(cExt, high), nz(lastPH, high)) : na
float ckTgt = armDir == 1 ? (phase > 0 ? rHi : nz(poolHi, high)) : armDir == -1 ? (phase > 0 ? rLo : nz(poolLo, low)) : na
ckRR = not na(ckStop) and not na(ckTgt) and math.abs(close - ckStop) > 0 ? math.abs(ckTgt - close) / math.abs(close - ckStop) : na
ckRRok = not na(ckRR) and ckRR >= 3

// ═══ מטריצת TF-ים — פאזה + כל האישורים לכל מסגרת ═══
f_state() =>
    rs = ta.rsi(close, rsiLen)
    vr = ta.percentrank(volume, 250)
    atrF = ta.atr(14)
    clx = vr >= 95
    e12 = ta.ema(close, emaLen)
    hi20f = ta.highest(high, 20)
    lo20f = ta.lowest(low, 20)
    hi10f = ta.highest(high, 10)
    lo10f = ta.lowest(low, 10)
    p1 = ta.pivothigh(high, 5, 5)
    p2 = ta.pivotlow(low, 5, 5)
    var float lph = na
    var float lpl = na
    if not na(p1)
        lph := p1
    if not na(p2)
        lpl := p2
    xU = ta.crossover(close, lph)
    xD = ta.crossunder(close, lpl)
    bU = not na(lph) and xU
    bD = not na(lpl) and xD
    var int dir = 0
    if bU
        dir := 1
    if bD
        dir := -1
    lo30f = ta.lowest(low, 30)
    hi30f = ta.highest(high, 30)
    sc = clx and low <= lo30f and close[20] - close >= atrF
    bc = clx and high >= hi30f and close - close[20] >= atrF
    var int phs = 0
    var int pd = 0
    var float av = na
    var float rh = na
    var float rl = na
    var int aB = na
    var int bB = na
    var int cB = na
    var int dB = na
    var int eB = na
    var int cd = 0
    var bool tst = false
    var float sx = na
    var float sxo = na
    var float so = na
    var float eX = na
    var float eO = na
    var bool cOpen = false
    var float vHi = na
    var float vLo = na
    var int aXB = na
    rng = nz(rh - rl, 0)
    if phs == 1
        if pd == -1
            if high > rh
                rh := high
                aXB := bar_index
                rl := float(na)
            else
                rl := na(rl) ? low : math.min(rl, low)
        else
            if low < rl
                rl := low
                aXB := bar_index
                rh := float(na)
            else
                rh := na(rh) ? high : math.max(rh, high)
        arN = pd == 1 ? (not na(p1) and bar_index - 5 > aXB) : (not na(p2) and bar_index - 5 > aXB)
        if arN
            phs := 2
            bB := bar_index
        else if bar_index - aB > 40
            phs := 0
    var int sd = 0
    var float sv = na
    var float swx = na
    var int sB = na
    sp = false
    ut = false
    if phs == 2 or phs == 3 or phs == 4
        if sd == 0 and low < rl
            sd := 1
            sB := bar_index
            sv := volume
            swx := low
            so := high
        else if sd == 0 and high > rh
            sd := -1
            sB := bar_index
            sv := volume
            swx := high
            so := low
        else if sd == 1
            sv := math.max(sv, volume)
            if low < swx
                swx := low
                so := high
            if close > rl
                if (phs == 3 and cd > 0) or sv >= av * 0.8 or vr >= 95
                    sp := true
                sd := 0
            else if close < rl - rng * 0.25 or bar_index - sB > 20
                phs := 5
                cd := -1
                eX := swx
                eO := so
                eB := bar_index
                sd := 0
        else if sd == -1
            sv := math.max(sv, volume)
            if high > swx
                swx := high
                so := low
            if close < rh
                if (phs == 3 and cd < 0) or sv >= av * 0.8 or vr >= 95
                    ut := true
                sd := 0
            else if close > rh + rng * 0.25 or bar_index - sB > 20
                phs := 5
                cd := 1
                eX := swx
                eO := so
                eB := bar_index
                sd := 0
        if phs == 2 and bar_index - bB > 200
            phs := 0
    if sp or ut
        nd = sp ? 1 : -1
        sameC = phs == 3 and cd != 0 and (cd > 0) == (nd > 0)
        keepOld = sameC and not na(sx) and (sp ? swx >= sx : swx <= sx)
        cd := nd
        phs := 3
        cB := bar_index
        sx := keepOld ? sx : swx
        sxo := keepOld ? sxo : so
        tst := sameC ? tst : false
        cOpen := false
    vC = sd == 0 and rng > 0 and low >= rl and high <= rh and not (sp or ut) and (volume >= av * 0.8 or vr >= 95)
    if vC and phs == 2
        cd := 0
        cOpen := true
        phs := 3
        cB := bar_index
        vHi := high
        vLo := low
        sx := float(na)
        sxo := float(na)
        tst := false
    else if vC and phs == 3 and cOpen
        vHi := math.max(vHi, high)
        vLo := math.min(vLo, low)
    if phs == 3 and cOpen
        lU = not na(p2) and bar_index - 5 > cB and p2 > vLo and p2 < vHi and volume[5] < av
        lD = not na(p1) and bar_index - 5 > cB and p1 < vHi and p1 > vLo and volume[5] < av
        if close > vHi or (lU and not lD)
            cd := 2
            cOpen := false
            sx := vLo
            sxo := vHi
        else if close < vLo or (lD and not lU)
            cd := -2
            cOpen := false
            sx := vHi
            sxo := vLo
    if (phs == 3 or phs == 4) and not cOpen and cd != 0 and not na(sx)
        if cd > 0 and not na(p2) and bar_index - 5 > cB and p2 > sx and volume[5] < av
            tst := true
        if cd < 0 and not na(p1) and bar_index - 5 > cB and p1 < sx and volume[5] < av
            tst := true
    if (phs == 3 or phs == 4) and not na(sx) and vr <= 25
        if cd > 0 and math.abs(low - sx) <= atrF * 0.5
            tst := true
        if cd < 0 and math.abs(high - sx) <= atrF * 0.5
            tst := true
    var int fireB = na
    var int fd = 0
    if phs == 3 and cd != 0 and (cd > 0 ? (bU or close > sxo) : (bD or close < sxo))
        phs := 4
        dB := bar_index
        fireB := bar_index
        fd := cd
    if (phs == 3 or phs == 4) and sd == 0 and not na(sx) and (cd > 0 ? close < sx : close > sx)
        brk = cd > 0 ? close < rl - rng * 0.25 : close > rh + rng * 0.25
        cd := -cd
        if brk
            phs := 5
            eB := bar_index
            eX := cd > 0 ? high : low
            eO := cd > 0 ? low : high
        else
            phs := 4
            dB := bar_index
            cB := bar_index
            fireB := bar_index
            fd := cd
            sxo := cd > 0 ? low : high
            sx := cd > 0 ? nz(lpl, low) : nz(lph, high)
            tst := false
        sd := 0
    eBrk2 = cd > 0 ? (close > rh + rng * 0.25 or (close > rh and close[1] > rh and low > rh)) : (close < rl - rng * 0.25 or (close < rl and close[1] < rl and high < rl))
    if phs == 4 and eBrk2
        phs := 5
        eB := bar_index
        eX := cd > 0 ? high : low
        eO := cd > 0 ? low : high
        sd := 0
    if phs == 4 and bar_index - dB > 60
        phs := 3
        cB := bar_index
        sd := 0
    if phs == 5 and bar_index - eB > 100
        phs := 0
    if phs == 5 and (na(eX) or (cd > 0 ? high > eX : low < eX))
        eX := cd > 0 ? high : low
        eO := cd > 0 ? low : high
    if phs == 5 and not na(eB) and bar_index - eB <= 20 and (cd > 0 ? close < rh : close > rl)
        cd := -cd
        sx := eX
        sxo := nz(eO, cd > 0 ? high : low)
        cB := bar_index
        phs := 3
        sd := 0
        tst := false
    if (sc or bc) and (phs == 0 or ((phs == 5 and not na(eB) and bar_index - eB > 20 or phs == 2) and (bc ? high > rh + rng * 0.25 : low < rl - rng * 0.25)))
        phs := 1
        pd := sc ? 1 : -1
        av := volume
        aB := bar_index
        aXB := bar_index
        rh := sc ? float(na) : high
        rl := sc ? low : float(na)
        cd := 0
        tst := false
        sx := na
        sd := 0
    var int lastClx = na
    if clx
        lastClx := bar_index
    c1 = not na(lastClx) and bar_index - lastClx <= 60
    var int upCnt = 0
    var int dnCnt = 0
    if bU
        upCnt += 1
        dnCnt := 0
    if bD
        dnCnt += 1
        upCnt := 0
    c2 = (dir > 0 ? upCnt : dnCnt) >= 2
    c3 = dir > 0 ? close > close[10] and vr < 50 : close < close[10] and vr < 50
    var bool flipH = false
    if bU
        flipH := false
    if dir > 0 and not na(lph[1]) and low <= lph[1] + atrF * 0.25 and close > lph[1]
        flipH := true
    if dir < 0 and not na(lpl[1]) and high >= lpl[1] - atrF * 0.25 and close < lpl[1]
        flipH := true
    c4 = flipH
    clB = (c1 ? 1 : 0) + (c2 ? 2 : 0) + (c3 ? 4 : 0) + (c4 ? 8 : 0)
    zn = phs > 0 and not na(rh) ? (close < rh - (rh - rl) * 0.2 and close > rl + (rh - rl) * 0.2 ? 0 : 1) : -1
    var float pl1 = na
    var float pl2 = na
    var float phB = na
    var float ph1 = na
    var float ph2 = na
    var float plB = na
    var int wm = 0
    if (not na(p1) or not na(p2)) and math.abs(wm) == 2
        wm := 0
    if not na(p2)
        pl2 := pl1
        pl1 := p2
        phB := lph
    if not na(p1)
        ph2 := ph1
        ph1 := p1
        plB := lpl
    wB = not na(pl1) and not na(pl2) and not na(phB) and math.abs(pl1 - pl2) <= atrF * 0.5 and phB > math.max(pl1, pl2)
    mB = not na(ph1) and not na(ph2) and not na(plB) and math.abs(ph1 - ph2) <= atrF * 0.5 and plB < math.min(ph1, ph2)
    xW = ta.crossover(close, nz(phB, close))
    xM = ta.crossunder(close, nz(plB, close))
    if wB and wm == 0
        wm := 1
    if mB and wm == 0
        wm := -1
    if wm == 1 and xW
        wm := 2
    if wm == -1 and xM
        wm := -2
    var int tS = 0
    var float tStop = na
    var float tTgt = na
    var int tDir = 0
    var int bN = 0
    var int bW = 0
    if tS == 1
        hS = tDir > 0 ? low <= tStop : high >= tStop
        hT = tDir > 0 ? high >= tTgt : low <= tTgt
        if hS
            tS := 0
        else if hT
            bW += 1
            tS := 0
    if not na(fireB) and fireB == bar_index and tS == 0 and inBT
        tDir := fd
        tStop := fd > 0 ? rl : rh
        if fd > 0 ? close > tStop : close < tStop
            tS := 1
            tTgt := fd > 0 ? close + (close - tStop) * targetR : close - (tStop - close) * targetR
            bN += 1
    // ── v56: EMA, פרופיל הטווח (POC/אזור ערך של התהליך), FVG/iFVG, SMT (צד הנכס) ──
    var map<int, float> rp = map.new<int, float>()
    var float rpBin = na
    var int rpPocI = na
    var float rpPocV = 0.0
    var float rpTot = 0.0
    float rpPoc = na
    float rpVah = na
    float rpVal = na
    if phs == 1 and aB == bar_index
        map.clear(rp)
        rpBin := math.max(syminfo.mintick, atrF * 0.1)
        rpPocI := na
        rpPocV := 0.0
        rpTot := 0.0
    if phs > 0 and not na(rpBin)
        rlo_ = int(math.floor(low / rpBin))
        rnb_ = math.min(int(math.floor(high / rpBin)) - rlo_ + 1, 400)
        rper_ = volume / rnb_
        for bi = rlo_ to rlo_ + rnb_ - 1
            rv = nz(map.get(rp, bi)) + rper_
            map.put(rp, bi, rv)
            if rv > rpPocV
                rpPocV := rv
                rpPocI := bi
        rpTot += volume
        if not na(rpPocI)
            rpPoc := (rpPocI + 0.5) * rpBin
            if barstate.islast and rpTot > 0
                float acc = rpPocV
                int up = rpPocI
                int dn = rpPocI
                float need = rpTot * vpVA / 100
                int guard = 0
                while acc < need and guard < 600
                    vu = nz(map.get(rp, up + 1))
                    vd = nz(map.get(rp, dn - 1))
                    if vu >= vd
                        up += 1
                        acc += vu
                    else
                        dn -= 1
                        acc += vd
                    guard += 1
                rpVah := (up + 1) * rpBin
                rpVal := dn * rpBin
    var float fbTop = na
    var float fbBot = na
    var int fbSt = 0
    var int fbBar = na
    var float fsTop = na
    var float fsBot = na
    var int fsSt = 0
    var int fsBar = na
    dispF = high[1] - low[1] >= atrF * 1.2
    if dispF and low - high[2] >= atrF * 0.5 and low > high[2]
        fbTop := low
        fbBot := high[2]
        fbSt := 1
        fbBar := bar_index
    if dispF and low[2] - high >= atrF * 0.5 and high < low[2]
        fsTop := low[2]
        fsBot := high
        fsSt := 1
        fsBar := bar_index
    bool fbTouch = false
    bool fsTouch = false
    if fbSt == 1 and bar_index > fbBar
        if close < fbBot
            fbSt := 2
        else if low <= fbTop and close > fbBot
            fbTouch := true
    else if fbSt == 2
        if high >= fbTop
            fbSt := 0
        else if high >= fbBot and close < fbTop
            fbTouch := true
    if fsSt == 1 and bar_index > fsBar
        if close > fsTop
            fsSt := 2
        else if high >= fsBot and close < fsTop
            fsTouch := true
    else if fsSt == 2
        if low <= fsBot
            fsSt := 0
        else if low <= fsTop and close > fsBot
            fsTouch := true
    if fbSt > 0 and bar_index - fbBar > 200
        fbSt := 0
    if fsSt > 0 and bar_index - fsBar > 200
        fsSt := 0
    fbCode = fbSt == 0 ? 0 : fbSt == 1 ? (fbTouch ? 3 : bar_index - fbBar <= 3 ? 2 : 1) : (fbTouch ? 5 : 4)
    fsCode = fsSt == 0 ? 0 : fsSt == 1 ? (fsTouch ? 3 : bar_index - fsBar <= 3 ? 2 : 1) : (fsTouch ? 5 : 4)
    mHi20 = high >= hi20f
    mLo20 = low <= lo20f
    mNewHi = high > high[1] and high >= hi10f and close < high[1]
    mNewLo = low < low[1] and low <= lo10f and close > low[1]
    [phs, dir, cd, na(fireB) ? -1 : bar_index - fireB, fd, tst ? 1 : 0, zn, clB, wm, bN, bW, rs, close > e12 ? 1 : -1, e12 > e12[1] ? 1 : 0, rpPoc, rpVah, rpVal, fbCode, fsCode, mHi20, mLo20, mNewHi, mNewLo, bar_index]
// צד הנכס המתואם לכל מסגרת (SMT/iSMT): שיא/שפל 20 נרות, פריצת הנר הקודם
f_pair() =>
    h20 = ta.highest(high, 20)
    l20 = ta.lowest(low, 20)
    [high >= h20, low <= l20, high > high[1], low < low[1]]
[phD, dirD, cdD, agoD, fdD, tsD, znD, clD, wmD, bnD, bwD, rsD, eSD, eUD, rpPD, rpHD, rpLD, fbD, fsD, mH20D, mL20D, mNHD, mNLD, nbD] = request.security(syminfo.tickerid, "D", f_state(), lookahead=barmerge.lookahead_off)
[ph4, dir4, cd4, ago4, fd4, ts4, zn4, cl4, wm4, bn4, bw4, rs4, eS4, eU4, rpP4, rpH4, rpL4, fb4, fs4, mH204, mL204, mNH4, mNL4, nb4] = request.security(syminfo.tickerid, "240", f_state(), lookahead=barmerge.lookahead_off)
[ph1h, dir1h, cd1h, ago1h, fd1h, ts1h, zn1h, cl1h, wm1h, bn1h, bw1h, rs1h, eS1h, eU1h, rpP1h, rpH1h, rpL1h, fb1h, fs1h, mH201h, mL201h, mNH1h, mNL1h, nb1h] = request.security(syminfo.tickerid, "60", f_state(), lookahead=barmerge.lookahead_off)
[ph15, dir15, cd15, ago15, fd15, ts15, zn15, cl15, wm15, bn15, bw15, rs15, eS15, eU15, rpP15, rpH15, rpL15, fb15, fs15, mH2015, mL2015, mNH15, mNL15, nb15] = request.security(syminfo.tickerid, "15", f_state(), lookahead=barmerge.lookahead_off)
[ph5m, dir5m, cd5m, ago5m, fd5m, ts5m, zn5m, cl5m, wm5m, bn5m, bw5m, rs5m, eS5m, eU5m, rpP5m, rpH5m, rpL5m, fb5m, fs5m, mH205m, mL205m, mNH5m, mNL5m, nb5m] = request.security(syminfo.tickerid, "5", f_state(), lookahead=barmerge.lookahead_off)
[pH20D, pL20D, pNHD, pNLD] = request.security(smtSym, "D", f_pair(), lookahead=barmerge.lookahead_off)
[pH204, pL204, pNH4, pNL4] = request.security(smtSym, "240", f_pair(), lookahead=barmerge.lookahead_off)
[pH201h, pL201h, pNH1h, pNL1h] = request.security(smtSym, "60", f_pair(), lookahead=barmerge.lookahead_off)
[pH2015, pL2015, pNH15, pNL15] = request.security(smtSym, "15", f_pair(), lookahead=barmerge.lookahead_off)
[pH205m, pL205m, pNH5m, pNL5m] = request.security(smtSym, "5", f_pair(), lookahead=barmerge.lookahead_off)
// SMT/iSMT לכל מסגרת: הנכס עשה שיא/שפל והצמד לא — מוצג אם קרה ב-10 הנרות האחרונים של אותה מסגרת
f_smtCode(bool mh, bool ml, bool nh, bool nl, bool ph_, bool pl_, bool pnh, bool pnl, float tfm) =>
    w = math.max(1, math.round(10 * tfm / tfMin))
    sb = ta.barssince(smtOn and mh and not ph_) <= w
    su = ta.barssince(smtOn and ml and not pl_) <= w
    ib = ta.barssince(smtOn and nh and not pnh) <= w
    iu = ta.barssince(smtOn and nl and not pnl) <= w
    (su ? 1 : 0) + (sb ? 2 : 0) + (iu ? 4 : 0) + (ib ? 8 : 0)
smtCD = f_smtCode(mH20D, mL20D, mNHD, mNLD, pH20D, pL20D, pNHD, pNLD, 1440)
smtC4 = f_smtCode(mH204, mL204, mNH4, mNL4, pH204, pL204, pNH4, pNL4, 240)
smtC1h = f_smtCode(mH201h, mL201h, mNH1h, mNL1h, pH201h, pL201h, pNH1h, pNL1h, 60)
smtC15 = f_smtCode(mH2015, mL2015, mNH15, mNL15, pH2015, pL2015, pNH15, pNL15, 15)
smtC5m = f_smtCode(mH205m, mL205m, mNH5m, mNL5m, pH205m, pL205m, pNH5m, pNL5m, 5)
chartSmtC = (ta.barssince(smtBull) <= 10 ? 1 : 0) + (ta.barssince(smtBear) <= 10 ? 2 : 0) + (ta.barssince(ismtBull) <= 10 ? 4 : 0) + (ta.barssince(ismtBear) <= 10 ? 8 : 0)
f_smtTxt(int c) =>
    st = (c % 2 == 1 ? "SMT ▲ · " : "") + (math.floor(c / 2) % 2 == 1 ? "SMT ▼ · " : "") + (math.floor(c / 4) % 2 == 1 ? "iSMT ▲ · " : "") + (math.floor(c / 8) % 2 == 1 ? "iSMT ▼ · " : "")
    str.length(st) > 3 ? str.substring(st, 0, str.length(st) - 3) : "—"
f_fvgOne(int c, bool bull) => c == 0 ? "" : c <= 3 ? ("FVG " + (bull ? "▲" : "▼") + (c == 2 ? " טרי" : c == 3 ? " נגע" : "")) : ("iFVG " + (bull ? "▼" : "▲") + (c == 5 ? " נגע" : ""))
f_fvgTxt(int b, int sc) =>
    a1 = f_fvgOne(b, true)
    c1 = f_fvgOne(sc, false)
    a1 == "" and c1 == "" ? "—" : a1 == "" ? c1 : c1 == "" ? a1 : a1 + " · " + c1
f_emaTxt(int side, int up2) => (side > 0 ? "מעל " : "מתחת ") + (up2 == 1 ? "▲" : "▼")
f_pocTxt(float p) => na(p) ? "—" : math.abs(close - p) <= pocTol ? "על ה-POC" : (close > p ? "מעל +" : "מתחת −") + str.tostring(math.abs(close - p) / close * 100, "#.##") + "%"
f_vaTxt(float h2, float l2) => na(h2) or na(l2) ? "—" : close > h2 ? "יקר" : close < l2 ? "זול" : "בפנים"
f_px(float v) => na(v) ? "—" : str.tostring(v, "#.##")
f_pctD(float v) => na(v) ? "" : " (" + (v >= close ? "+" : "−") + str.tostring(math.abs(v - close) / close * 100, "#.##") + "%)"
// כמה נרות יש לכל מסגרת גבוהה מטווח הגרף הנוכחי — פחות מהמינימום = המנוע מורעב, מסמנים "?" במקום לנחש
htfMinBars = input.int(400, "מינימום נרות למסגרת גבוהה (פחות = '?' מעט נתונים)", minval=50, maxval=3000, group=gT)
f_starveTip(int nb, string tfn) => "מעט נתונים: " + str.tostring(nb + 1) + " נרות במסגרת " + tfn + " מתוך טווח הגרף הנוכחי (מינימום " + str.tostring(htfMinBars) + "). הפאזה והכיוון כאן לא אמינים — פתח גרף " + tfn + " לקריאה אמיתית"
f_phN(int p) => p == 1 ? "A" : p == 2 ? "B" : p == 3 ? "C" : p == 4 ? "D" : p == 5 ? "E" : "—"
f_dirN(int d) => d > 0 ? "שורי" : d < 0 ? "דובי" : "—"
f_trigN(int p, int cd2, int ago2, int fd2) => ago2 >= 0 and ago2 <= 40 ? (fd2 > 0 ? "נורה ↑" : "נורה ↓") : p == 3 ? (cd2 > 0 ? "✈ חמוש" : cd2 < 0 ? "כנף חמוש" : "חמוש") : p == 4 ? "תפיסת כיוון" : "—"
f_wmN(int v) => v == 1 ? "W נבנית" : v == -1 ? "M נבנית" : v == 2 ? "W✓" : v == -2 ? "M✓" : "—"
f_cluCnt(int b) => b % 2 + math.floor(b / 2) % 2 + math.floor(b / 4) % 2 + math.floor(b / 8) % 2
f_cluTip(int b) => "4 רמזי הכיוון:\n1· בלימה בווליום ענק לאחרונה: " + (b % 2 == 1 ? "✓" : "✗") + "\n2· שני BOS ומעלה באותו כיוון: " + (math.floor(b / 2) % 2 == 1 ? "✓" : "✗") + "\n3· מתקדם בקלות על ווליום נמוך: " + (math.floor(b / 4) % 2 == 1 ? "✓" : "✗") + "\n4· הפליפ האחרון מחזיק: " + (math.floor(b / 8) % 2 == 1 ? "✓" : "✗")
pct(int w2, int n2) => n2 > 0 ? str.tostring(math.round(w2 * 100.0 / n2)) + "%" : "—"
plot(clues, "רמזים (0-4)", color.new(color.gray, 100), editable=false)
vAnch = tblLayout == "טלפון" ? "bottom" : tblShiftY > 0 ? "top" : tblShiftY < 0 ? "bottom" : str.contains(tblPosS, "עליון") ? "top" : str.contains(tblPosS, "תחתון") ? "bottom" : "middle"
hAnch = tblLayout == "טלפון" ? "center" : tblShiftX > 0 ? "left" : tblShiftX < 0 ? "right" : str.contains(tblPosS, "שמאל") ? "left" : str.contains(tblPosS, "ימין") ? "right" : "center"
tblPos = vAnch == "top" ? (hAnch == "left" ? position.top_left : hAnch == "right" ? position.top_right : position.top_center) : vAnch == "bottom" ? (hAnch == "left" ? position.bottom_left : hAnch == "right" ? position.bottom_right : position.bottom_center) : (hAnch == "left" ? position.middle_left : hAnch == "right" ? position.middle_right : position.middle_center)
cx = tblShiftX > 0 ? tblShiftX : 0
cy = tblShiftY > 0 ? tblShiftY : 0
szL = tblLayout == "טלפון" ? size.small : tblSizeS == "זעיר" ? size.tiny : tblSizeS == "קטן" ? size.small : tblSizeS == "רגיל" ? size.normal : size.large
szN = tblLayout == "טלפון" ? size.tiny : tblSizeS == "זעיר" ? size.tiny : tblSizeS == "קטן" ? size.small : tblSizeS == "רגיל" ? size.normal : size.normal
szS = tblLayout == "טלפון" ? size.tiny : tblSizeS == "זעיר" ? size.tiny : tblSizeS == "קטן" ? size.small : tblSizeS == "רגיל" ? size.small : size.normal
var table t = table.new(tblPos, 32, 40, border_width=1, frame_color=color.rgb(19, 23, 34), frame_width=1, border_color=color.rgb(19, 23, 34))
BG  = color.rgb(19, 23, 34)
BG2 = color.rgb(28, 33, 46)
HDR = color.rgb(52, 58, 75)
SEP = color.rgb(40, 46, 60)
TXT = color.rgb(235, 238, 245)
MUT = color.rgb(160, 168, 185)
GRN = color.rgb(8, 153, 129)
RED = color.rgb(242, 54, 69)
f_phBG(int p) => p == 1 ? color.rgb(0, 121, 107) : p == 2 ? color.rgb(84, 92, 110) : p == 3 ? color.rgb(198, 40, 40) : p == 4 ? color.rgb(21, 101, 192) : p == 5 ? color.rgb(46, 125, 50) : BG2
f_cell(int c, int r, string s2, color bg, color tx, string sz) =>
    table.cell(t, c + cx, r + cy, s2, bgcolor=bg, text_color=tx, text_size=sz)
    true
f_cellT(int c, int r, string s2, color bg, color tx, string sz, string tip) =>
    table.cell(t, c + cx, r + cy, s2, bgcolor=bg, text_color=tx, text_size=sz, tooltip=tip)
    true
f_spacers(int lastCol, int lastRow) =>
    if tblShiftX > 0
        for sc = 0 to tblShiftX - 1
            table.cell(t, sc, cy, "", width=3, bgcolor=color.new(color.black, 100))
    if tblShiftX < 0
        for sc = 1 to -tblShiftX
            table.cell(t, lastCol + cx + sc, cy, "", width=3, bgcolor=color.new(color.black, 100))
    if tblShiftY > 0
        for sr = 0 to tblShiftY - 1
            table.cell(t, cx, sr, "", height=3, bgcolor=color.new(color.black, 100))
    if tblShiftY < 0
        for sr = 1 to -tblShiftY
            table.cell(t, cx, lastRow + cy + sr, "", height=3, bgcolor=color.new(color.black, 100))
    true
f_tri(int c, int r, int v, color rb) =>
    f_cell(c, r, v == 1 ? "✓" : v == 0 ? "✗" : "—", v == 1 ? GRN : v == 0 ? color.new(RED, 45) : rb, v >= 0 ? color.white : MUT, szN)
    true
rsiV = ta.rsi(close, rsiLen)
f_rsiTxt(float r) => na(r) ? "—" : str.tostring(r, "#") + (r >= rsiHi ? " ↓" : r <= rsiLo ? " ↑" : "")
f_rsiBG(float r, color base) => na(r) ? base : r >= rsiHi ? color.new(RED, 40) : r <= rsiLo ? color.new(GRN, 40) : base
tipRsi = "RSI " + str.tostring(rsiLen) + " (הקורס: הרגיל, רמות " + str.tostring(rsiHi) + "/" + str.tostring(rsiLo) + "). ↑ = מתחת ל-" + str.tostring(rsiLo) + " (מכור מדי → צפי לעלייה, לונג), ↓ = מעל " + str.tostring(rsiHi) + " (קנוי מדי → צפי לירידה, שורט). אישור בקצה של אזור עניין, לא טריגר. 🎬 25-9, 35-1"
qTip2 = "רבע לפי קנה המידה של המסגרת: יומי = רבע שבועי (ב'=Q1…ה'=Q4) · 4H = רבע יומי (6 שעות מ-18:00 NY) · 1H = רבע של 90 דק' · 15m/5m = מיקרו-רבע (22.5 דק'). צהוב = רבע המניפולציה של 90 הדקות"
HDR2 = color.rgb(62, 54, 82)
f_smtCol(int c, color base) => c == 0 ? base : (c % 2 == 1 or math.floor(c / 4) % 2 == 1) and (math.floor(c / 2) % 2 == 1 or math.floor(c / 8) % 2 == 1) ? color.new(color.yellow, 60) : (c % 2 == 1 or math.floor(c / 4) % 2 == 1) ? color.new(GRN, 40) : color.new(RED, 45)
f_withTxt(int cd2, int d) => cd2 > 0 and d >= 0 ? "שורי" : cd2 < 0 and d <= 0 ? "דובי" : cd2 != 0 ? "✗" : "—"
f_withBG(int cd2, int d, color base) => cd2 > 0 and d >= 0 ? GRN : cd2 < 0 and d <= 0 ? color.new(RED, 20) : cd2 != 0 ? color.new(RED, 55) : base
f_emaBG(int eS, int eU, color base) => eS > 0 and eU == 1 ? color.new(GRN, 35) : eS < 0 and eU == 0 ? color.new(RED, 40) : base
tipPocTf = "POC של פרופיל הווליום של התהליך במסגרת הזו (מתחילת הטווח): מעל/מתחת + מרחק. 'על ה-POC' = בתוך מרחק הנגיעה. POC של היום — בבלוק Volume Profile למטה"
tipVaTf = "אזור הערך (70% מהווליום) של פרופיל התהליך במסגרת הזו: בפנים = מחיר הוגן (צפי לסיבוב) · יקר = מעל VAH · זול = מתחת ל-VAL"
tipEma = "EMA " + str.tostring(emaLen) + ": מעל/מתחת + כיוון הממוצע (▲ עולה / ▼ יורד). ירוק = מעל ועולה (לונג), אדום = מתחת ויורד (שורט)"
tipSmtTf = "SMT = הנכס עשה שיא/שפל של 20 נרות והצמד לא · iSMT = הנכס פרץ את הנר הקודם וסגר חזרה והצמד לא פרץ. מוצג אם קרה ב-10 הנרות האחרונים של המסגרת. ▲ = לונג, ▼ = שורט. אם יש שניהם — מוצגים שניהם"
tipFvgTf = "FVG = מרווח פעיל (▲ שורי מתחת למחיר / ▼ דובי מעל) · טרי = נוצר ב-3 הנרות האחרונים · נגע = המחיר בדק אותו עכשיו · iFVG = מרווח שנשבר והתהפך (▼ = עכשיו התנגדות, ▲ = עכשיו תמיכה)"
f_rowW(int r, string nm, int p, int d, string trg, int cd2, int ts2, int zn2, int clB2, int parentPh, int wm2, float rs2, int eS, int eU, float rpP, float rpH, float rpL, int fbC, int fsC, int smtC, string qTxt, bool qHot) =>
    inSyn = (parentPh == 3 or parentPh == 4) and p >= 3
    rb = inSyn ? color.rgb(66, 55, 10) : r % 2 == 0 ? BG : BG2
    f_cell(0, r, nm, rb, TXT, szL)
    f_cell(1, r, f_phN(p), f_phBG(p), color.white, szL)
    f_cell(2, r, f_dirN(d), rb, d > 0 ? GRN : d < 0 ? RED : MUT, szN)
    f_cell(3, r, trg, rb, trg == "—" ? MUT : color.yellow, szN)
    f_cell(4, r, cd2 == 2 ? "V↑" : cd2 == -2 ? "V↓" : cd2 > 0 ? "S" : cd2 < 0 ? "U" : p == 3 ? "V" : "—", cd2 > 0 ? GRN : cd2 < 0 ? color.new(color.orange, 25) : p == 3 ? color.new(color.purple, 25) : rb, cd2 != 0 or p == 3 ? color.white : MUT, szN)
    f_tri(5, r, p >= 3 ? ts2 : -1, rb)
    f_cell(6, r, parentPh == 0 ? "—" : "בתוך " + f_phN(parentPh), rb, inSyn ? color.yellow : MUT, szN)
    f_tri(7, r, zn2, rb)
    f_cell(8, r, f_withTxt(cd2, d), f_withBG(cd2, d, rb), cd2 != 0 ? color.white : MUT, szN)
    f_cellT(9, r, str.tostring(f_cluCnt(clB2)) + "/4", rb, f_cluCnt(clB2) >= 3 ? color.yellow : TXT, szN, f_cluTip(clB2))
    f_cell(10, r, f_wmN(wm2), rb, math.abs(wm2) == 2 ? color.yellow : wm2 != 0 ? TXT : MUT, szN)
    f_cellT(11, r, f_rsiTxt(rs2), f_rsiBG(rs2, rb), color.white, szN, tipRsi)
    f_cellT(12, r, f_smtTxt(smtC), f_smtCol(smtC, rb), smtC != 0 ? color.white : MUT, szN, tipSmtTf)
    f_cellT(13, r, f_fvgTxt(fbC, fsC), rb, fbC != 0 or fsC != 0 ? TXT : MUT, szN, tipFvgTf)
    f_cellT(14, r, f_emaTxt(eS, eU), f_emaBG(eS, eU, rb), color.white, szN, tipEma)
    f_cellT(15, r, f_pocTxt(rpP), rb, na(rpP) ? MUT : math.abs(close - rpP) <= pocTol ? color.yellow : TXT, szN, tipPocTf)
    f_cellT(16, r, f_vaTxt(rpH, rpL), rb, na(rpH) ? MUT : TXT, szN, tipVaTf)
    f_cellT(17, r, qTxt, rb, qHot ? color.yellow : TXT, szN, qTip2)
    true
f_colP(int c, string nm, int p, int d, string trg, int cd2, int ts2, int zn2, int clB2, int parentPh, int wm2, float rs2, int eS, int eU, float rpP, float rpH, float rpL, int fbC, int fsC, int smtC, string qTxt, bool qHot) =>
    f_cell(c, 0, nm, HDR, TXT, szN)
    f_cell(c, 1, f_phN(p), f_phBG(p), color.white, szN)
    f_cell(c, 2, f_dirN(d), BG, d > 0 ? GRN : d < 0 ? RED : MUT, szS)
    f_cell(c, 3, trg, BG2, trg == "—" ? MUT : color.yellow, szS)
    f_cell(c, 4, cd2 == 2 ? "V↑" : cd2 == -2 ? "V↓" : cd2 > 0 ? "S" : cd2 < 0 ? "U" : p == 3 ? "V" : "—", cd2 > 0 ? GRN : cd2 < 0 ? color.new(color.orange, 25) : p == 3 ? color.new(color.purple, 25) : BG, cd2 != 0 or p == 3 ? color.white : MUT, szS)
    f_tri(c, 5, p >= 3 ? ts2 : -1, BG2)
    f_cell(c, 6, parentPh == 0 ? "—" : f_phN(parentPh), BG, MUT, szS)
    f_tri(c, 7, zn2, BG2)
    f_cell(c, 8, f_withTxt(cd2, d), f_withBG(cd2, d, BG), cd2 != 0 ? color.white : MUT, szS)
    f_cellT(c, 9, str.tostring(f_cluCnt(clB2)) + "/4", BG2, f_cluCnt(clB2) >= 3 ? color.yellow : TXT, szS, f_cluTip(clB2))
    f_cell(c, 10, f_wmN(wm2), BG, math.abs(wm2) == 2 ? color.yellow : wm2 != 0 ? TXT : MUT, szS)
    f_cell(c, 11, f_rsiTxt(rs2), f_rsiBG(rs2, BG2), color.white, szS)
    f_cell(c, 12, f_smtTxt(smtC), f_smtCol(smtC, BG), smtC != 0 ? color.white : MUT, szS)
    f_cell(c, 13, f_fvgTxt(fbC, fsC), BG2, fbC != 0 or fsC != 0 ? TXT : MUT, szS)
    f_cell(c, 14, f_emaTxt(eS, eU), f_emaBG(eS, eU, BG), color.white, szS)
    f_cell(c, 15, f_pocTxt(rpP), BG2, na(rpP) ? MUT : math.abs(close - rpP) <= pocTol ? color.yellow : TXT, szS)
    f_cell(c, 16, f_vaTxt(rpH, rpL), BG, na(rpH) ? MUT : TXT, szS)
    f_cell(c, 17, qTxt, BG2, qHot ? color.yellow : TXT, szS)
    true
// ─── תורת הרבעים (Daye) לטבלה: רבעים, מודל AMD/XAMD של 90 הדקות, True Opens ───
QT_TZ = "America/New_York"
QT_MS = 60000.0
qtOff = (hour(time, QT_TZ) * 60 + minute(time, QT_TZ) - 1080 + 1440) % 1440
qtDayStart = time - qtOff * QT_MS - second(time, QT_TZ) * 1000
int qtDayIdx = int(math.floor(qtOff / 360))
int qt90Idx = int(math.floor((qtOff % 360) / 90))
qtDayQStart = qtDayStart + qtDayIdx * 360.0 * QT_MS
qt90Start = qtDayQStart + qt90Idx * 90.0 * QT_MS
qtTd = time + 21600000
qtDow = dayofweek(qtTd, QT_TZ)
qtDom = dayofmonth(qtTd, QT_TZ)
qtNewDay = na(qtDom[1]) ? false : qtDom != qtDom[1]
int qtWkIdx = qtDow == dayofweek.monday ? 0 : qtDow == dayofweek.tuesday ? 1 : qtDow == dayofweek.wednesday ? 2 : qtDow == dayofweek.thursday ? 3 : -1
qtNew90 = na(qt90Start[1]) ? false : qt90Start != qt90Start[1]
qtNewDayQ = na(qtDayQStart[1]) ? false : qtDayQStart != qtDayQStart[1]
var float qtHi = na
var float qtLo = na
var float qtAvgR = na
var string qtModel = "AMD"
if qtNew90
    if not na(qtHi)
        float qr = qtHi - qtLo
        qtAvgR := na(qtAvgR) ? qr : qtAvgR * 0.9 + qr * 0.1
        if qt90Idx[1] == 0
            qtModel := qr > qtAvgR * 1.35 ? "XAMD" : "AMD"
    qtHi := high
    qtLo := low
else
    qtHi := math.max(nz(qtHi, high), high)
    qtLo := math.min(nz(qtLo, low), low)
qtInManip = qt90Idx == (qtModel == "AMD" ? 1 : 2)
var float qtTSO = na
var float qtTDO = na
var float qtTWO = na
if qtNew90 and qt90Idx == 1
    qtTSO := open
if qtNewDayQ and qtDayIdx == 1
    qtTDO := open
if qtNewDay and qtDow == dayofweek.tuesday
    qtTWO := open
f_qtPhHe(int idx, string md) => md == "AMD" ? (idx == 0 ? "צבירה" : idx == 1 ? "מניפולציה" : idx == 2 ? "חלוקה" : "המשך") : (idx == 0 ? "המשך" : idx == 1 ? "צבירה" : idx == 2 ? "מניפולציה" : "חלוקה")
f_qtSide(float lvl) => na(lvl) ? "—" : close > lvl ? "מעל" : "מתחת"
qtRowTxt = (qtWkIdx >= 0 ? "שבועי Q" + str.tostring(qtWkIdx + 1) : "שבועי —") + " · יומי Q" + str.tostring(qtDayIdx + 1) + " (" + f_qtPhHe(qtDayIdx, "AMD") + ") · 90' Q" + str.tostring(qt90Idx + 1) + " (" + f_qtPhHe(qt90Idx, qtModel) + ", " + qtModel + ")"
qtToTxt = "יומי " + f_qtSide(qtTDO) + " · סשן " + f_qtSide(qtTSO) + " · שבועי " + f_qtSide(qtTWO)
qtTip = "תורת הרבעים (Daye): שבועי ב'=Q1…ה'=Q4 · יומי 18:00 NY=Q1 אסיה, 00:00=Q2 לונדון, 06:00=Q3 ניו-יורק, 12:00=Q4 · 90 דק' בתוך כל סשן. AMD: Q1 צבירה, Q2 מניפולציה (Judas), Q3 חלוקה; XAMD כש-Q1 מתוח"
qtToTip = "המחיר מול הפתיחה האמיתית: יומי = 00:00 NY · סשן = תחילת Q2 של 90 הדקות · שבועי = יום ב' 18:00 NY. מתחת = דיסקאונט (טוב ללונג), מעל = פרימיום (טוב לשורט)"
qtMicroIdx = int(math.floor((qtOff % 90) / 22.5))
qtSesHe = qtDayIdx == 0 ? "אסיה" : qtDayIdx == 1 ? "לונדון" : qtDayIdx == 2 ? "ניו-יורק" : "אחה\"צ"
qTxtD = (qtWkIdx >= 0 ? "שבועי Q" + str.tostring(qtWkIdx + 1) : "שבועי —") + " (" + dayName + "')"
qTxt4 = "יומי Q" + str.tostring(qtDayIdx + 1) + " · " + qtSesHe
qTxt1h = "90' Q" + str.tostring(qt90Idx + 1) + " · " + f_qtPhHe(qt90Idx, qtModel)
qTxt15 = "90' Q" + str.tostring(qt90Idx + 1) + " · מיקרו Q" + str.tostring(qtMicroIdx + 1)
qTxt5m = "מיקרו Q" + str.tostring(qtMicroIdx + 1) + " · 90' Q" + str.tostring(qt90Idx + 1)
f_starveW(int r, int nb, string tfn) =>
    if nb >= 0 and nb + 1 < htfMinBars
        f_cellT(1, r, "?", color.new(color.gray, 55), color.white, szL, f_starveTip(nb, tfn))
        f_cell(2, r, "—", BG, MUT, szN)
f_starveP(int c, int nb, string tfn) =>
    if nb >= 0 and nb + 1 < htfMinBars
        f_cellT(c, 1, "?", color.new(color.gray, 55), color.white, szN, f_starveTip(nb, tfn))
        f_cell(c, 2, "—", BG, MUT, szS)
// צ'ק-ליסט של הגרף הנוכחי: 7 פריטים — Test, קצה, 1:3, סשן, עם מרחב, EMA, POC
f_ckList() =>
    string m = ""
    int n = 0
    if armDir != 0
        okT = ckTest
        okZ = okZone
        okR = ckRRok
        okS = ckSes
        okM = (armDir > 0 and msDir >= 0) or (armDir < 0 and msDir <= 0)
        okE = armDir > 0 ? ema12OkL : ema12OkS
        okP = armDir > 0 ? (pocAtL or (not na(pocNow) and close > pocNow)) : (pocAtS or (not na(pocNow) and close < pocNow))
        n := (okT ? 1 : 0) + (okZ ? 1 : 0) + (okR ? 1 : 0) + (okS ? 1 : 0) + (okM ? 1 : 0) + (okE ? 1 : 0) + (okP ? 1 : 0)
        m := (okT ? "" : "Test · ") + (okZ ? "" : "קצה · ") + (okR ? "" : "1:3 · ") + (okS ? "" : "סשן · ") + (okM ? "" : "עם מרחב · ") + (okE ? "" : "EMA · ") + (okP ? "" : "POC · ")
    [n, str.length(m) > 3 ? str.substring(m, 0, str.length(m) - 3) : ""]
[ckN, ckMiss] = f_ckList()
// מצב המסגרת של הגרף עצמו (למסגרת שאינה אחת מחמש הקבועות)
[phC_, dirC_, cdC_, agoC_, fdC_, tsC_, znC_, clC_, wmC_, bnC_, bwC_, rsC_, eSC_, eUC_, rpPC_, rpHC_, rpLC_, fbC_, fsC_, mH20C_, mL20C_, mNHC_, mNLC_, nbC_] = request.security(syminfo.tickerid, timeframe.period, f_state(), lookahead=barmerge.lookahead_off)
if barstate.islast
    curTrig = fSt == 1 ? "✈ פתוח" : wSt == 1 ? "כנף פתוח" : oSt == 1 ? "OB פתוח" : wmSt == 1 ? "W/M פתוח" : pocSt == 1 ? "P פתוח" : armDir == 1 ? "✈ חמוש" : armDir == -1 ? "✈ חמוש שורט" : "—"
    tfp = timeframe.period
    isStdTF = tfp == "D" or tfp == "240" or tfp == "60" or tfp == "15" or tfp == "5"
    chartClB = (clue1 ? 1 : 0) + (clue2 ? 2 : 0) + (clue3 ? 4 : 0) + (clue4 ? 8 : 0)
    chartWm = wState == 2 ? 2 : wState == 1 ? 1 : mState == 2 ? -2 : mState == 1 ? -1 : 0
    synCnt = ((ph4 >= 3 ? 1 : 0) + (ph1h >= 3 ? 1 : 0) + (ph15 >= 3 ? 1 : 0) + (ph5m >= 3 ? 1 : 0))
    bosPend = armDir == 1 ? "BOS: סגירה מעל " + str.tostring(lastPH, format.mintick) : armDir == -1 ? "BOS: סגירה מתחת " + str.tostring(lastPL, format.mintick) : "BOS: —"
    qChart = tfMin >= 1440 ? qTxtD : tfMin >= 240 ? qTxt4 : tfMin >= 60 ? qTxt1h : tfMin >= 15 ? qTxt15 : qTxt5m
    chartTxt = "הגרף (" + tfp + ") · " + (armDir == 1 ? "✈ לונג חמוש" : armDir == -1 ? "✈ שורט חמוש" : "אין סטאפ") + " · RSI " + f_rsiTxt(rsiV)
    rrTxt = "יחס 1:3 " + (na(ckRR) ? "—" : str.tostring(ckRR, "#.#")) + (ckRRok ? " ✓" : " ✗") + (na(ckStop) ? "" : " · סטופ " + f_px(ckStop) + " · יעד " + f_px(ckTgt))
    sesTxt = "סשן " + sesName + (ckSes ? " ✓" : " ✗") + " · מיקום " + str.tostring(pdPct) + "% " + (inPrem ? "פרימיום" : "דיסקאונט")
    amdTxt = "AMD " + amdPh + " · סינרגיה " + (synCnt >= 3 ? "🔥 " : "") + str.tostring(synCnt) + "/4"
    ckTxt = armDir == 0 ? "צ'ק-ליסט: אין סטאפ חמוש" : "צ'ק-ליסט " + str.tostring(ckN) + "/7" + (ckMiss == "" ? " ✓ הכול" : " · חסר: " + ckMiss)
    lastTrigTxt = na(trigAgo) ? "טריגר אחרון: —" : "טריגר אחרון: " + lastTrigNm + " לפני " + str.tostring(trigAgo) + " נרות"
    btTxt = "בקטסט " + str.tostring(targetR, "#") + "R · " + btPeriod
    flyTxt = "✈ טיסה " + str.tostring(fW) + "/" + str.tostring(fN) + " · " + pct(fW, fN)
    wingTxt = "כנף " + str.tostring(wW) + "/" + str.tostring(wN) + " · " + pct(wW, wN)
    obwmTxt = "OB " + str.tostring(oW) + "/" + str.tostring(oN) + " · W/M " + str.tostring(wmW) + "/" + str.tostring(wmN)
    pTxt = "P ריטסט POC " + str.tostring(pocW) + "/" + str.tostring(pocN) + " · " + pct(pocW, pocN)
    sesBtTxt = "לונ' " + str.tostring(array.get(sesW, 1)) + "/" + str.tostring(array.get(sesN, 1)) + " · ניו' " + str.tostring(array.get(sesW, 2)) + "/" + str.tostring(array.get(sesN, 2)) + " · אס' " + str.tostring(array.get(sesW, 0)) + "/" + str.tostring(array.get(sesN, 0))
    flyTfTxt = "✈ טיסה לפי מסגרת: D " + str.tostring(bwD) + "/" + str.tostring(bnD) + " · 4H " + str.tostring(bw4) + "/" + str.tostring(bn4) + " · 1H " + str.tostring(bw1h) + "/" + str.tostring(bn1h) + " · 15m " + str.tostring(bw15) + "/" + str.tostring(bn15) + " · 5m " + str.tostring(bw5m) + "/" + str.tostring(bn5m)
    pocDirTxt = pocRising ? " ▲ עולה" : pocFalling ? " ▼ יורד" : ""
    vaRelTxt = na(prevVah) or na(vah) ? "" : val > prevVah ? " · מול אתמול: גבוה (מגמה ↑)" : vah < prevVal ? " · מול אתמול: נמוך (מגמה ↓)" : val >= prevVal and vah <= prevVah ? " · מול אתמול: בפנים (איזון)" : " · מול אתמול: חופף"
    vpTxt = na(pocNow) ? "Volume Profile\nPOC היום: עוד אין (" + str.tostring(vpDayN) + "/" + str.tostring(vpMinBars) + " נרות)" : "Volume Profile · POC היום " + f_px(pocNow) + pocDirTxt + " · ערך " + f_px(val) + "–" + f_px(vah) + " (" + f_vaTxt(vah, val) + ")" + vaRelTxt + "\nnPOC ↑ " + f_px(npUp) + f_pctD(npUp) + " · ↓ " + f_px(npDn) + f_pctD(npDn)
    zTxt = "אזורי עיגון (" + str.tostring(zBarsN) + " נרות): " + (zIn > 0 ? "בתוך #" + str.tostring(zIn) : "מחוץ") + " · למעלה " + f_px(zUp) + f_pctD(zUp) + " · למטה " + f_px(zDn) + f_pctD(zDn) + "\n#1 " + f_px(zp1) + " · #2 " + f_px(zp2) + " · #3 " + f_px(zp3)
    dayTxt = "יום " + dayName + "' · מודל 90' " + qtModel + " · " + qTxt5m
    tipVp = "POC היום = המחיר שבו נסחר הכי הרבה ווליום היום (מתעדכן) · ערך = VAL–VAH (" + str.tostring(vpVA, "#") + "%) · מול אתמול: גבוה/נמוך = יום מגמה, בפנים/חופף = איזון · nPOC = POC של ימים קודמים שעוד לא נגעו בו (יעד)"
    tipZ = "אזורי עיגון = שלושת צמתי הווליום הגבוהים (HVN) ב-" + str.tostring(zBarsN) + " הנרות האחרונים, לפי סדר עוצמה (#1 הכי חזק). 'מאיפה לאן': בתוך איזה אזור אנחנו ומה האזור הבא למעלה ולמטה. מצוירים על הגרף ב-HTT Master"
    if tblLayout == "טלפון"
        f_spacers(6, 29)
        f_cell(0, 0, "TF", HDR, TXT, szN)
        f_cell(0, 1, "פאזה", HDR, TXT, szS)
        f_cell(0, 2, "מרחב", HDR, TXT, szS)
        f_cell(0, 3, "טריגר", HDR, TXT, szS)
        f_cell(0, 4, "S/U", HDR, TXT, szS)
        f_cell(0, 5, "Test", HDR, TXT, szS)
        f_cell(0, 6, "בתוך", HDR, TXT, szS)
        f_cell(0, 7, "קצה", HDR2, TXT, szS)
        f_cell(0, 8, "עם מרחב", HDR2, TXT, szS)
        f_cellT(0, 9, "רמזים", HDR2, TXT, szS, "4 רמזי הכיוון — רחף על התא לפירוט")
        f_cell(0, 10, "W/M", HDR2, TXT, szS)
        f_cellT(0, 11, "RSI", HDR2, TXT, szS, tipRsi)
        f_cellT(0, 12, "SMT", HDR2, TXT, szS, tipSmtTf)
        f_cellT(0, 13, "FVG", HDR2, TXT, szS, tipFvgTf)
        f_cellT(0, 14, "EMA", HDR2, TXT, szS, tipEma)
        f_cellT(0, 15, "POC", HDR2, TXT, szS, tipPocTf)
        f_cellT(0, 16, "ערך", HDR2, TXT, szS, tipVaTf)
        f_cellT(0, 17, "רבע", HDR2, TXT, szS, qTip2)
        f_colP(1, "D", phD, dirD, tfp == "D" ? curTrig : f_trigN(phD, cdD, agoD, fdD), cdD, tsD, znD, clD, 0, wmD, rsD, eSD, eUD, rpPD, rpHD, rpLD, fbD, fsD, smtCD, qTxtD, false)
        f_colP(2, "4H", ph4, dir4, tfp == "240" ? curTrig : f_trigN(ph4, cd4, ago4, fd4), cd4, ts4, zn4, cl4, phD, wm4, rs4, eS4, eU4, rpP4, rpH4, rpL4, fb4, fs4, smtC4, qTxt4, qtDayIdx == 1)
        f_colP(3, "1H", ph1h, dir1h, tfp == "60" ? curTrig : f_trigN(ph1h, cd1h, ago1h, fd1h), cd1h, ts1h, zn1h, cl1h, ph4, wm1h, rs1h, eS1h, eU1h, rpP1h, rpH1h, rpL1h, fb1h, fs1h, smtC1h, qTxt1h, qtInManip)
        f_colP(4, "15m", ph15, dir15, tfp == "15" ? curTrig : f_trigN(ph15, cd15, ago15, fd15), cd15, ts15, zn15, cl15, ph1h, wm15, rs15, eS15, eU15, rpP15, rpH15, rpL15, fb15, fs15, smtC15, qTxt15, qtInManip)
        f_colP(5, "5m", ph5m, dir5m, tfp == "5" ? curTrig : f_trigN(ph5m, cd5m, ago5m, fd5m), cd5m, ts5m, zn5m, cl5m, ph15, wm5m, rs5m, eS5m, eU5m, rpP5m, rpH5m, rpL5m, fb5m, fs5m, smtC5m, qTxt5m, qtInManip)
        f_starveP(1, nbD, "D")
        f_starveP(2, nb4, "4H")
        f_starveP(3, nb1h, "1H")
        f_starveP(4, nb15, "15m")
        f_starveP(5, nb5m, "5m")
        if not isStdTF
            f_colP(6, tfp, phase, msDir, curTrig, armDir, ckTest ? 1 : 0, phase > 0 ? (okZone ? 1 : 0) : -1, chartClB, 0, chartWm, rsiV, close > ema12 ? 1 : -1, emaRising ? 1 : 0, rpPC_, rpHC_, rpLC_, fbC_, fsC_, chartSmtC, qChart, qtInManip)
        f_cell(0, 18, "הגרף (" + tfp + ")", HDR, TXT, szS)
        f_cell(1, 18, (armDir == 1 ? "✈ לונג חמוש" : armDir == -1 ? "✈ שורט חמוש" : "אין סטאפ") + " · RSI " + f_rsiTxt(rsiV), HDR, armDir != 0 ? color.yellow : MUT, szS)
        f_cell(3, 18, "יחס 1:3", HDR, TXT, szS)
        f_cell(4, 18, (na(ckRR) ? "—" : str.tostring(ckRR, "#.#")) + (ckRRok ? " ✓" : " ✗") + (na(ckStop) ? "" : " · סטופ " + f_px(ckStop) + " · יעד " + f_px(ckTgt)), ckRRok ? GRN : color.new(RED, 45), color.white, szS)
        f_cell(0, 19, "סשן", BG2, TXT, szS)
        f_cell(1, 19, sesName + (ckSes ? " ✓" : " ✗"), ckSes ? GRN : color.new(RED, 45), color.white, szS)
        f_cell(3, 19, "מיקום", BG2, TXT, szS)
        f_cell(4, 19, str.tostring(pdPct) + "% " + (inPrem ? "פרימיום" : "דיסקאונט"), BG2, TXT, szS)
        f_cell(0, 20, "AMD", BG, TXT, szS)
        f_cell(1, 20, amdPh + " · סינרגיה " + str.tostring(synCnt) + "/4", BG, synCnt >= 3 ? color.yellow : TXT, szS)
        f_cell(3, 20, "BOS", BG, TXT, szS)
        f_cell(4, 20, bosPend, BG, color.yellow, szS)
        f_cell(0, 21, "צ'ק-ליסט", BG2, TXT, szS)
        f_cell(1, 21, armDir == 0 ? "אין סטאפ חמוש" : str.tostring(ckN) + "/7" + (ckMiss == "" ? " ✓ הכול" : " · חסר: " + ckMiss), BG2, ckN >= 6 ? color.yellow : TXT, szS)
        f_cell(3, 21, "טריגר", BG2, TXT, szS)
        f_cell(4, 21, na(trigAgo) ? "—" : lastTrigNm + " לפני " + str.tostring(trigAgo), BG2, TXT, szS)
        f_cell(0, 22, "בקטסט " + str.tostring(targetR, "#") + "R", HDR, TXT, szS)
        f_cell(1, 22, btPeriod, HDR, MUT, szS)
        f_cell(3, 22, "✈ טיסה", HDR, TXT, szS)
        f_cell(4, 22, str.tostring(fW) + "/" + str.tostring(fN) + " · " + pct(fW, fN), HDR, TXT, szS)
        f_cell(0, 23, "כנף", BG2, TXT, szS)
        f_cell(1, 23, str.tostring(wW) + "/" + str.tostring(wN) + " · " + pct(wW, wN), BG2, TXT, szS)
        f_cell(3, 23, "OB · W/M", BG2, TXT, szS)
        f_cell(4, 23, str.tostring(oW) + "/" + str.tostring(oN) + " · " + str.tostring(wmW) + "/" + str.tostring(wmN), BG2, TXT, szS)
        f_cell(0, 24, "P ריטסט POC", BG, TXT, szS)
        f_cell(1, 24, str.tostring(pocW) + "/" + str.tostring(pocN) + " · " + pct(pocW, pocN), BG, TXT, szS)
        f_cell(3, 24, "סשנים", BG, MUT, szS)
        f_cell(4, 24, sesBtTxt, BG, TXT, szS)
        f_cellT(0, 25, "רבעים", BG2, TXT, szS, qtTip)
        f_cell(1, 25, qtRowTxt, BG2, qtInManip ? color.yellow : TXT, szS)
        f_cellT(0, 26, "True Open", BG, TXT, szS, qtToTip)
        f_cell(1, 26, qtToTxt, BG, TXT, szS)
        f_cellT(0, 27, "VP", BG2, TXT, szS, tipVp)
        f_cell(1, 27, vpTxt, BG2, TXT, szS)
        f_cellT(0, 28, "עיגון", BG, TXT, szS, tipZ)
        f_cell(1, 28, zTxt, BG, TXT, szS)
        f_cell(0, 29, "✈ TF", BG2, MUT, szS)
        f_cell(1, 29, flyTfTxt, BG2, MUT, szS)
        for pr = 18 to 24
            table.merge_cells(t, cx + 1, cy + pr, cx + 2, cy + pr)
            table.merge_cells(t, cx + 4, cy + pr, cx + 5, cy + pr)
        for pr = 25 to 29
            table.merge_cells(t, cx + 1, cy + pr, cx + 5, cy + pr)
    else
        f_spacers(17, 13)
        f_cell(0, 0, "", HDR, TXT, szS)
        f_cell(1, 0, "ליבה — איפה אנחנו בתהליך", HDR, TXT, szS)
        f_cell(7, 0, "אישורים — מה תומך בכניסה", HDR2, TXT, szS)
        table.merge_cells(t, cx + 1, cy + 0, cx + 6, cy + 0)
        table.merge_cells(t, cx + 7, cy + 0, cx + 17, cy + 0)
        f_cell(0, 1, "TF", HDR, TXT, szN)
        f_cell(1, 1, "פאזה", HDR, TXT, szN)
        f_cellT(2, 1, "מרחב", HDR, TXT, szN, "מרחב קונים/מוכרים (12-5): כיוון ה-BOS האחרון. שורי = מרחב קונים, דובי = מרחב מוכרים")
        f_cell(3, 1, "טריגר", HDR, TXT, szN)
        f_cellT(4, 1, "S/U", HDR, TXT, szN, "ספרינג (S) / אפ-טראסט (U) — כיוון ההכרעה של פאזה C · V = C לפי ווליום בלי ניעור (כיוון עוד לא ידוע) → V↑/V↓ אחרי שה-LPS קבע כיוון")
        f_cellT(5, 1, "Test", HDR, TXT, szN, "טסט (22-4): חזרה בווליום נמוך אחרי C — LPS/LPSY או נגיעה באזור הניעור")
        f_cellT(6, 1, "בתוך", HDR, TXT, szN, "הפאזה של המסגרת שמעל. צהוב = סינרגיה (המסגרת שמעל ב-C/D וגם זו ב-C ומעלה)")
        f_cellT(7, 1, "קצה", HDR2, TXT, szN, "אזור עניין (48-1): המחיר ב-20% העליונים או התחתונים של הטווח (אייס↔קריק). ✗ = במרכז = שטח מת")
        f_cellT(8, 1, "עם מרחב", HDR2, TXT, szN, "ההכרעה (S/U) תואמת לכיוון המרחב: שורי = ספרינג במרחב קונים, דובי = UT במרחב מוכרים, ✗ = ניעור נגד המבנה")
        f_cellT(9, 1, "רמזים", HDR2, TXT, szN, "4 רמזי הכיוון של הקורס — רחף על התא בשורה לפירוט מלא")
        f_cellT(10, 1, "W/M", HDR2, TXT, szN, "דאבל בוטום/טופ: נבנית = שני שפלים/שיאים שווים; ✓ = סגירה מעבר לצוואר")
        f_cellT(11, 1, "RSI", HDR2, TXT, szN, tipRsi)
        f_cellT(12, 1, "SMT/iSMT", HDR2, TXT, szN, tipSmtTf)
        f_cellT(13, 1, "FVG/iFVG", HDR2, TXT, szN, tipFvgTf)
        f_cellT(14, 1, "EMA " + str.tostring(emaLen), HDR2, TXT, szN, tipEma)
        f_cellT(15, 1, "POC", HDR2, TXT, szN, tipPocTf)
        f_cellT(16, 1, "אזור ערך", HDR2, TXT, szN, tipVaTf)
        f_cellT(17, 1, "רבע", HDR2, TXT, szN, qTip2)
        f_rowW(2, "D", phD, dirD, tfp == "D" ? curTrig : f_trigN(phD, cdD, agoD, fdD), cdD, tsD, znD, clD, 0, wmD, rsD, eSD, eUD, rpPD, rpHD, rpLD, fbD, fsD, smtCD, qTxtD, false)
        f_rowW(3, "4H", ph4, dir4, tfp == "240" ? curTrig : f_trigN(ph4, cd4, ago4, fd4), cd4, ts4, zn4, cl4, phD, wm4, rs4, eS4, eU4, rpP4, rpH4, rpL4, fb4, fs4, smtC4, qTxt4, qtDayIdx == 1)
        f_rowW(4, "1H", ph1h, dir1h, tfp == "60" ? curTrig : f_trigN(ph1h, cd1h, ago1h, fd1h), cd1h, ts1h, zn1h, cl1h, ph4, wm1h, rs1h, eS1h, eU1h, rpP1h, rpH1h, rpL1h, fb1h, fs1h, smtC1h, qTxt1h, qtInManip)
        f_rowW(5, "15m", ph15, dir15, tfp == "15" ? curTrig : f_trigN(ph15, cd15, ago15, fd15), cd15, ts15, zn15, cl15, ph1h, wm15, rs15, eS15, eU15, rpP15, rpH15, rpL15, fb15, fs15, smtC15, qTxt15, qtInManip)
        f_rowW(6, "5m", ph5m, dir5m, tfp == "5" ? curTrig : f_trigN(ph5m, cd5m, ago5m, fd5m), cd5m, ts5m, zn5m, cl5m, ph15, wm5m, rs5m, eS5m, eU5m, rpP5m, rpH5m, rpL5m, fb5m, fs5m, smtC5m, qTxt5m, qtInManip)
        f_starveW(2, nbD, "D")
        f_starveW(3, nb4, "4H")
        f_starveW(4, nb1h, "1H")
        f_starveW(5, nb15, "15m")
        f_starveW(6, nb5m, "5m")
        if not isStdTF
            f_rowW(7, "גרף (" + tfp + ")", phase, msDir, curTrig, armDir, ckTest ? 1 : 0, phase > 0 ? (okZone ? 1 : 0) : -1, chartClB, 0, chartWm, rsiV, close > ema12 ? 1 : -1, emaRising ? 1 : 0, rpPC_, rpHC_, rpLC_, fbC_, fsC_, chartSmtC, qChart, qtInManip)
        f_cell(0, 8, bosPend, BG2, color.yellow, szS)
        f_cell(6, 8, smtOn ? "SMT מול " + smtSym : "SMT: אין צמד לנכס הזה", BG2, MUT, szS)
        f_cell(12, 8, dayTxt, BG2, TXT, szS)
        table.merge_cells(t, cx + 0, cy + 8, cx + 5, cy + 8)
        table.merge_cells(t, cx + 6, cy + 8, cx + 11, cy + 8)
        table.merge_cells(t, cx + 12, cy + 8, cx + 17, cy + 8)
        if not tblCompact
            f_cell(0, 9, "הגרף (" + tfp + ")\n" + (armDir == 1 ? "✈ לונג חמוש" : armDir == -1 ? "✈ שורט חמוש" : "אין סטאפ") + " · RSI " + f_rsiTxt(rsiV), HDR, armDir != 0 ? color.yellow : TXT, szN)
            f_cell(3, 9, "יחס 1:3 " + (na(ckRR) ? "—" : str.tostring(ckRR, "#.#")) + (ckRRok ? " ✓" : " ✗") + "\n" + (na(ckStop) ? "סטופ — · יעד —" : "סטופ " + f_px(ckStop) + " · יעד " + f_px(ckTgt)), ckRRok ? GRN : color.new(RED, 45), color.white, szN)
            f_cell(6, 9, "סשן " + sesName + (ckSes ? " ✓" : " ✗") + "\nמיקום " + str.tostring(pdPct) + "% " + (inPrem ? "פרימיום" : "דיסקאונט"), ckSes ? GRN : color.new(RED, 45), color.white, szN)
            f_cell(9, 9, "AMD " + amdPh + "\nסינרגיה " + (synCnt >= 3 ? "🔥 " : "") + str.tostring(synCnt) + "/4", BG, synCnt >= 3 ? color.yellow : TXT, szN)
            f_cell(12, 9, armDir == 0 ? "צ'ק-ליסט\nאין סטאפ חמוש" : "צ'ק-ליסט " + str.tostring(ckN) + "/7\n" + (ckMiss == "" ? "✓ הכול" : "חסר: " + ckMiss), BG2, armDir != 0 and ckN >= 6 ? color.yellow : TXT, szN)
            f_cell(15, 9, "טריגר אחרון\n" + (na(trigAgo) ? "—" : lastTrigNm + " לפני " + str.tostring(trigAgo) + " נרות"), BG, TXT, szN)
        f_cellT(0, 10, "בקטסט " + str.tostring(targetR, "#") + "R\n" + btPeriod, HDR, TXT, szN, "סטטיסטיקה חיה על הגרף הנוכחי לפי טריגר: פגיעות ביעד / כניסות · אחוז. סטופ = קצה הטווח/הניעור. בהגדרות: אסטרטגיה, תקופה אחרונה, טווח תאריכים. המדידה המלאה — Path Lab באתר")
        f_cell(3, 10, "✈ טיסה\n" + str.tostring(fW) + "/" + str.tostring(fN) + " · " + pct(fW, fN), BG, TXT, szN)
        f_cell(6, 10, "כנף\n" + str.tostring(wW) + "/" + str.tostring(wN) + " · " + pct(wW, wN), BG2, TXT, szN)
        f_cell(9, 10, "OB " + str.tostring(oW) + "/" + str.tostring(oN) + "\nW/M " + str.tostring(wmW) + "/" + str.tostring(wmN), BG, TXT, szN)
        f_cell(12, 10, "P ריטסט POC\n" + str.tostring(pocW) + "/" + str.tostring(pocN) + " · " + pct(pocW, pocN), BG2, TXT, szN)
        f_cell(15, 10, "סשנים\n" + sesBtTxt, BG, MUT, szN)
        if not tblCompact
            f_cellT(0, 11, "רבעים\n" + qtRowTxt, BG2, qtInManip ? color.yellow : TXT, szN, qtTip)
            f_cellT(9, 11, "True Open\n" + qtToTxt, BG, TXT, szN, qtToTip)
            f_cellT(0, 12, vpTxt, BG, TXT, szN, tipVp)
            f_cellT(9, 12, zTxt, BG2, zIn > 0 ? color.yellow : TXT, szN, tipZ)
            f_cell(0, 13, flyTfTxt, BG2, MUT, szN)
        for pr = 9 to 10
            table.merge_cells(t, cx + 0, cy + pr, cx + 2, cy + pr)
            table.merge_cells(t, cx + 3, cy + pr, cx + 5, cy + pr)
            table.merge_cells(t, cx + 6, cy + pr, cx + 8, cy + pr)
            table.merge_cells(t, cx + 9, cy + pr, cx + 11, cy + pr)
            table.merge_cells(t, cx + 12, cy + pr, cx + 14, cy + pr)
            table.merge_cells(t, cx + 15, cy + pr, cx + 17, cy + pr)
        for pr = 11 to 12
            table.merge_cells(t, cx + 0, cy + pr, cx + 8, cy + pr)
            table.merge_cells(t, cx + 9, cy + pr, cx + 17, cy + pr)
        table.merge_cells(t, cx + 0, cy + 13, cx + 17, cy + 13)
