//@version=6
indicator("HTT דשבורד — המשקפיים של חי טל", "HTTD", overlay=false, max_lines_count=50, max_labels_count=50)

// ─── מתגים ───────────────────────────────────────────────────────────────────
gM = "מודולים"
mFly  = input.bool(true,  "טיסה לונג+שורט",        group=gM)
mWing = input.bool(true,  "שבירת כנף",             group=gM)
mOB   = input.bool(true,  "אורדר בלוק",            group=gM)
mWM   = input.bool(true,  "W/M + דאבל/צבת",        group=gM)
mMC   = input.bool(false, "מונטה קרלו",            group=gM)
mFVG  = input.bool(false, "FVG / iFVG",            group=gM)
mSMT  = input.bool(false, "SMT / iSMT",            group=gM)
mLiq  = input.bool(true,  "נזילות + Judas",        group=gM)

g0 = "ליבה"
pivLen  = input.int(5, "אורך פיבוט", minval=2, group=g0)
volLook = input.int(250, "חלון אחוזון ווליום", minval=50, group=g0)
climaxP = input.int(95, "קליימקס — אחוזון", minval=80, maxval=99, group=g0)
lowVolP = input.int(15, "ווליום נמוך — אחוזון", minval=1, maxval=30, group=g0)
cVolK   = input.float(0.8, "C: יחס ווליום מ-A", minval=0.3, step=0.1, group=g0)
tolAtr  = input.float(0.25, "טולרנס שוויון (ATR)", minval=0.05, step=0.05, group=g0)
obDepth = input.float(21.0, "OB: עומק כניסה באזור %", minval=0, maxval=100, step=1, group=g0)
flyStrict = input.bool(false, "טיסה קפדנית — רק בפאזה D (הקורס); כבוי = C או D", group=g0)
twzTol = input.float(1.0, "צבת: הפרש מקסימלי בין השפלים/השיאים (נקודות)", minval=0.0, step=0.25, group=g0)
rsiLen = input.int(14, "RSI: אורך (הקורס: הרגיל)", minval=2, group=g0)
rsiHi = input.int(70, "RSI: רמה גבוהה", minval=50, maxval=95, group=g0)
rsiLo = input.int(30, "RSI: רמה נמוכה", minval=5, maxval=50, group=g0)
sqBars  = input.int(8, "אורך התכווצות", minval=4, group=g0)
sqAtrK  = input.float(2.5, "רוחב התכווצות (ATR)", minval=0.5, step=0.5, group=g0)
targetR = input.float(3.0, "יעד בדיקה (R)", minval=0.5, step=0.5, group=g0)
stopBuf = input.float(0.1, "מרווח סטופ %", minval=0.0, step=0.05, group=g0)

gS = "סשנים (שעון ישראל)"
sesAsia = input.session("0200-1000", "אסיה", group=gS)
sesLon  = input.session("1000-1800", "לונדון", group=gS)
sesNY   = input.session("1800-0100", "ניו יורק", group=gS)
orMin   = input.int(15, "טווח פתיחה (דקות)", minval=5, group=gS)

gW = "חיבור"
secret = input.string("dev-secret", "Secret", group=gW)
asset2Mode = input.string("אוטומטי", "נכס מתואם (SMT)", options=["אוטומטי", "ידני"], group=gW)
asset2Man = input.symbol("BINANCE:BTCUSDT", "נכס ידני (רק במצב ידני)", group=gW)

gB = "בקטסט"
btSel = input.string("הכול", "אסטרטגיה לבדיקה", options=["הכול", "טיסה", "כנף", "אורדר בלוק", "W/M"], group=gB)
btUseRange = input.bool(false, "הגבל לטווח תאריכים", group=gB)
btFrom = input.time(timestamp("01 Jan 2026 00:00 +0300"), "מתאריך", group=gB)
btTo = input.time(timestamp("31 Dec 2026 23:59 +0300"), "עד תאריך", group=gB)
btPeriod = input.string("הכול", "תקופה אחרונה (לחיצה אחת)", options=["הכול", "7 ימים", "30 יום", "90 יום", "365 יום"], group=gB)

gT = "טבלה"
tblPosS = input.string("תחתון-שמאל", "מיקום", options=["מרכז", "עליון-מרכז", "תחתון-מרכז", "שמאל-מרכז", "ימין-מרכז", "עליון-שמאל", "עליון-ימין", "תחתון-שמאל", "תחתון-ימין"], group=gT)
tblSizeS = input.string("קטן", "גודל טקסט", options=["זעיר", "קטן", "רגיל", "גדול"], group=gT)
tblCompact = input.bool(false, "מצב קומפקטי — רק מטריצה ובקטסט", group=gT)
tblLayoutS = input.string("רחב", "פריסה", options=["רחב", "טלפון"], group=gT)
tblLayout = tblLayoutS == "טלפון" ? "טלפון" : "רחב"
tblShiftX = input.int(0, "הזזה אופקית (+ ימינה / − שמאלה)", minval=-12, maxval=12, group=gT)
tblShiftY = input.int(0, "הזזה אנכית (+ למטה / − למעלה)", minval=-12, maxval=12, group=gT)

// ─── בסיס ────────────────────────────────────────────────────────────────────
atr = ta.atr(14)
volRank = ta.percentrank(volume, volLook)
volClimax = volRank >= climaxP
volLow    = volRank <= lowVolP
tol = atr * tolAtr
tfMin = timeframe.in_seconds() / 60
btDays = btPeriod == "7 ימים" ? 7 : btPeriod == "30 יום" ? 30 : btPeriod == "90 יום" ? 90 : btPeriod == "365 יום" ? 365 : 0
inBT = (not btUseRange or (time >= btFrom and time <= btTo)) and (btDays == 0 or time >= last_bar_time - btDays * 86400000)
btFly = btSel == "הכול" or btSel == "טיסה"
btWing = btSel == "הכול" or btSel == "כנף"
btOB = btSel == "הכול" or btSel == "אורדר בלוק"
btWM = btSel == "הכול" or btSel == "W/M"

ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low,  pivLen, pivLen)
var float lastPH = na
var float prevPH = na
var float lastPL = na
var float prevPL = na
var int lastPHi = na
var int prevPHi = na
var int lastPLi = na
var int prevPLi = na
if not na(ph)
    prevPH := lastPH
    prevPHi := lastPHi
    lastPH := ph
    lastPHi := bar_index - pivLen
if not na(pl)
    prevPL := lastPL
    prevPLi := lastPLi
    lastPL := pl
    lastPLi := bar_index - pivLen

xUpPH = ta.crossover(close, lastPH)
xDnPL = ta.crossunder(close, lastPL)
bosUp = not na(lastPH) and xUpPH
bosDn = not na(lastPL) and xDnPL
var int msDir = 0
chochUp = bosUp and msDir < 0
chochDn = bosDn and msDir > 0
if bosUp
    msDir := 1
if bosDn
    msDir := -1
// BOS לטיסה: רק נר 15 דקות ומעלה שסוגר מעבר לרמה (10-4). בגרף קטן — סגירת בלוק 15m
ch15 = ta.change(time("15"))
is15New = tfMin < 15 and nz(ch15, 0) != 0
var float c15a = na
var float c15b = na
if is15New
    c15b := c15a
    c15a := close[1]
bos15Up = not na(c15b) and not na(lastPH) and c15a > lastPH and c15b <= lastPH
bos15Dn = not na(c15b) and not na(lastPL) and c15a < lastPL and c15b >= lastPL
bosUpF = tfMin >= 15 ? bosUp : bos15Up
bosDnF = tfMin >= 15 ? bosDn : bos15Dn

// ─── וויקוף — לפי הקורס: A = קליימקס (SC/BC) → AR (33-10) · B = ST + איסוף נזילות · C = ניעור (ספרינג/UT) + טסט · D = תפיסת כיוון = ה-BOS הראשון אחרי C (48-1) · E = יציאה לדרך מעבר לקריק/אייס (41-5)
var int phase = 0
var int procDir = 0
var float aVol = na
var float rHi = na
var float rLo = na
var int aBar = na
var int bBar = na
var int cBar = na
var int dBar = na
var int eBar = na
var bool cIsBull = false
var float cExt = na
var bool testOK = false
var float cVolC = na
var bool noC = false
var bool cByVol = false
var bool cDirOpen = false
var float vcHi = na
var float vcLo = na
var int swpBar = na
var int cStartBar = na
var float swpOpp = na
var float cOpp = na
var float eExt = na
var float eOpp = na
var int aExtBar = na
lo30 = ta.lowest(low, 30)
hi30 = ta.highest(high, 30)
// קליימקס בקצה של מגמה: SC = ווליום קיצוני בשפל 30 נרות אחרי ירידה; BC = בשיא אחרי עלייה. קליימקס באמצע תנועה אינו A
scBar = volClimax and low <= lo30 and close[20] - close >= atr
bcBar = volClimax and high >= hi30 and close - close[20] >= atr
rngH = nz(rHi - rLo, 0)
// A → B: הריאקציה האוטומטית (AR) = הפיבוט הראשון נגד הקליימקס — מגדיר את הקריק (איסוף) / האייס (פיזור). "איך סימנת אייס וקריק אם לא היה AR?" (48-1)
if phase == 1
    if procDir == -1
        if high > rHi
            rHi := high
            aExtBar := bar_index
            rLo := float(na)
        else
            rLo := na(rLo) ? low : math.min(rLo, low)
    else
        if low < rLo
            rLo := low
            aExtBar := bar_index
            rHi := float(na)
        else
            rHi := na(rHi) ? high : math.max(rHi, high)
    arNow = procDir == 1 ? (not na(ph) and bar_index - pivLen > aExtBar) : (not na(pl) and bar_index - pivLen > aExtBar)
    if arNow
        phase := 2
        bBar := bar_index
    else if bar_index - aBar > 40
        phase := 0
// B: ניעורים משני הצדדים (33-10). ספרינג/UT = יציאה מהגבול בווליום גבוה וסגירה חזרה (רב-נרות). פריצה בלי C בכיוון התהליך = איסוף/פיזור חוזר → E (48-1: "איסוף חוזר לא מחייב C")
var int swpDir = 0
var float swpExt = na
var float swpVol = na
var float swpRank = na
spring = false
utSig = false
if phase == 2 or phase == 3 or phase == 4
    if swpDir == 0 and low < rLo
        swpDir := 1
        swpBar := bar_index
        swpOpp := high
        swpExt := low
        swpVol := volume
        swpRank := volRank
    else if swpDir == 0 and high > rHi
        swpDir := -1
        swpBar := bar_index
        swpOpp := low
        swpExt := high
        swpVol := volume
        swpRank := volRank
    else if swpDir == 1
        if low < swpExt
            swpExt := low
            swpOpp := high
        swpVol := math.max(swpVol, volume)
        swpRank := math.max(swpRank, volRank)
        if close > rLo
            if (phase == 3 and not cDirOpen and cIsBull) or swpVol >= aVol * cVolK or swpRank >= climaxP
                spring := true
            swpDir := 0
        else if close < rLo - rngH * 0.25 or bar_index - swpBar > 20
            noC := not (phase >= 3 and not cIsBull)
            phase := 5
            cIsBull := false
            eExt := swpExt
            eOpp := swpOpp
            eBar := bar_index
            swpDir := 0
    else if swpDir == -1
        if high > swpExt
            swpExt := high
            swpOpp := low
        swpVol := math.max(swpVol, volume)
        swpRank := math.max(swpRank, volRank)
        if close < rHi
            if (phase == 3 and not cDirOpen and not cIsBull) or swpVol >= aVol * cVolK or swpRank >= climaxP
                utSig := true
            swpDir := 0
        else if close > rHi + rngH * 0.25 or bar_index - swpBar > 20
            noC := not (phase >= 3 and cIsBull)
            phase := 5
            cIsBull := true
            eExt := swpExt
            eOpp := swpOpp
            eBar := bar_index
            swpDir := 0
    if phase == 2 and bar_index - bBar > 200
        phase := 0
// ניעור נוסף באותו כיוון בזמן C = הרחבה של אותו ניעור (הקצה והנר הנגדי מתעדכנים, הקופסה לא זזה). ניעור מתוך D = C חדשה
cExtNow = false
if spring or utSig
    sameC = phase == 3 and not cDirOpen and cIsBull == spring
    cExtNow := sameC
    keepOld = sameC and not na(cExt) and (spring ? swpExt >= cExt : swpExt <= cExt)
    phase := 3
    cIsBull := spring
    cBar := bar_index
    cStartBar := sameC ? cStartBar : swpBar
    cExt := keepOld ? cExt : swpExt
    cOpp := keepOld ? cOpp : swpOpp
    cVolC := sameC ? math.max(nz(cVolC, swpVol), swpVol) : swpVol
    testOK := sameC ? testOK : false
    noC := false
    cByVol := false
    cDirOpen := false
// C לפי ווליום בלי ניעור: נר בווליום ≈ לקליימקס בתוך הטווח (22-8: "פאזה C שלאו דווקא יצאה מגבולות הגזרה, היה לה ווליום חזק"; 10-4: "B נמשכת כל עוד לא ראינו ווליום ≈ A").
// הכיוון לפי החצי של הטווח שבו הנר (חצי תחתון = ספיגה על האייס → לונג). ניעור שיבוא אחריו באותו כיוון = הרחבה של אותה C
volClx = swpDir == 0 and rngH > 0 and low >= rLo and high <= rHi and not (spring or utSig) and (volume >= aVol * cVolK or volRank >= climaxP)
volC = volClx and phase == 2
if volC
    phase := 3
    cByVol := true
    cDirOpen := true
    cBar := bar_index
    cStartBar := bar_index
    vcHi := high
    vcLo := low
    cExt := float(na)
    cOpp := float(na)
    cVolC := volume
    testOK := false
    noC := false
else if phase == 3 and cDirOpen and volClx
    vcHi := math.max(vcHi, high)
    vcLo := math.min(vcLo, low)
    cVolC := math.max(cVolC, volume)
// הכיוון של C ווליום נקבע לפי ה-LPS (10-5: "ווליום גבוה, התכווצות, LPS, פריצה"): שפל גבוה יותר שנשמר מעל נר הווליום בווליום נמוך = LPS → לונג;
// שיא נמוך יותר מתחת לנר בווליום נמוך = LPSY → שורט. סגירה מעבר לנר לפני זה = ה-BOS הראשון נותן כיוון (48-1). אין טיימאאוט: ה-LPS יכול להיבנות לאט (המשתמש 8/9)
volDirUp = false
volDirDn = false
if phase == 3 and cDirOpen
    lpsUp = not na(pl) and bar_index - pivLen > cBar and pl > vcLo and pl < vcHi and volume[pivLen] < cVolC
    lpsDn = not na(ph) and bar_index - pivLen > cBar and ph < vcHi and ph > vcLo and volume[pivLen] < cVolC
    if close > vcHi or (lpsUp and not lpsDn)
        cIsBull := true
        cDirOpen := false
        cExt := vcLo
        cOpp := vcHi
        volDirUp := true
    else if close < vcLo or (lpsDn and not lpsUp)
        cIsBull := false
        cDirOpen := false
        cExt := vcHi
        cOpp := vcLo
        volDirDn := true
// LPS/LPSY בכל C וגם ב-D (המשתמש 9/9: "בכל מקרה בפאזה C"; 10-3: "ברגע שיצאנו לפאזה D כל LPS זה תהליך איסוף"): אחרי C עם כיוון — שפל בווליום נמוך שנשמר מעל קצה הניעור = LPS (10-5: "התכווצות, LPS, פריצה");
// שיא בווליום נמוך מתחת לקצה ה-UT = LPSY. נספר גם כטסט (חזרה בווליום נמוך, 22-4)
lpsMark = false
lpsyMark = false
if (phase == 3 or phase == 4) and not cDirOpen and not na(cExt)
    if cIsBull and not na(pl) and bar_index - pivLen > cBar and pl > cExt and volume[pivLen] < nz(cVolC, volume[pivLen] + 1)
        lpsMark := true
        testOK := true
    if not cIsBull and not na(ph) and bar_index - pivLen > cBar and ph < cExt and volume[pivLen] < nz(cVolC, volume[pivLen] + 1)
        lpsyMark := true
        testOK := true
// טסט: חזרה לאזור הניעור בווליום נמוך — ההיצע התייבש (22-4)
if (phase == 3 or phase == 4) and cIsBull and low <= cExt + tol and low >= cExt - tol * 2 and volLow
    testOK := true
if (phase == 3 or phase == 4) and not cIsBull and high >= cExt - tol and high <= cExt + tol * 2 and volLow
    testOK := true
// C → D: תפיסת כיוון = ה-BOS הראשון בכיוון ההכרעה ("יש צ'וץ' → מחכים לבוס. BOS ראשון נותן כיוון", 48-1)
if phase == 3 and not cDirOpen and (cIsBull ? (bosUp or close > cOpp) : (bosDn or close < cOpp))
    phase := 4
    dBar := bar_index
// הניעור נכשל: סגירה מעבר לקצה שלו → "כשצד אחד נכשל הצד השני מנסה" (חזרה ל-B); מעבר ל-25% מגובה הטווח → הטווח נשבר
// הניעור נכשל: סגירה מעבר לקצה שלו = הצד השני ניצח ("כשצד אחד נכשל הצד השני מנסה") → הסגירה הזאת היא ה-BOS של הצד השני → D הפוכה.
// מעבר ל-25% מגובה הטווח = הטווח נשבר → E
if (phase == 3 or phase == 4) and swpDir == 0 and (cIsBull ? close < cExt : close > cExt)
    brk = cIsBull ? close < rLo - rngH * 0.25 : close > rHi + rngH * 0.25
    cIsBull := not cIsBull
    if brk
        phase := 5
        eBar := bar_index
        noC := true
        eExt := cIsBull ? high : low
        eOpp := cIsBull ? low : high
    else
        phase := 4
        dBar := bar_index
        cBar := bar_index
        cOpp := cIsBull ? low : high
        cExt := cIsBull ? nz(lastPL, low) : nz(lastPH, high)
        testOK := false
    swpDir := 0
// D → E: יציאה לדרך = סגירה מעבר לקריק (איסוף) / מתחת לאייס (פיזור). "המרקאפ יוצא לדרך רק אחרי שסיימנו את הקריק" (41-5)
eBrk = cIsBull ? (close > rHi + rngH * 0.25 or (close > rHi and close[1] > rHi and low > rHi)) : (close < rLo - rngH * 0.25 or (close < rLo and close[1] < rLo and high < rLo))
if phase == 4 and eBrk
    phase := 5
    eBar := bar_index
    eExt := cIsBull ? high : low
    eOpp := cIsBull ? low : high
    swpDir := 0
if phase == 4 and bar_index - dBar > 60
    phase := 3
    cBar := bar_index
    cStartBar := bar_index
    swpDir := 0
// E: ניהול בלבד. מתאפס אחרי 100 נרות בלי תהליך חדש
if phase == 5 and bar_index - eBar > 100
    phase := 0
if phase == 5 and (na(eExt) or (cIsBull ? high > eExt : low < eExt))
    eExt := cIsBull ? high : low
    eOpp := cIsBull ? low : high
// פריצה שחזרה לתוך הטווח תוך 20 נרות = פריצת שווא (ניעור מהצד הזה), לא יציאה לדרך → C בכיוון ההפוך
if phase == 5 and bar_index - eBar <= 20 and (cIsBull ? close < rHi : close > rLo)
    cIsBull := not cIsBull
    cExt := eExt
    cOpp := nz(eOpp, cIsBull ? high : low)
    cBar := bar_index
    cStartBar := eBar
    phase := 3
    swpDir := 0
    noC := false
// A נפתחת רק בקליימקס בקצה מגמה. "וויקוף לא מנחשים מפאזה A — בונים אחרי C" (48-1): A/B מוצגות, לא נסחרות
if (scBar or bcBar) and (phase == 0 or ((phase == 5 and bar_index - eBar > 20 or phase == 2) and (bcBar ? high > rHi + rngH * 0.25 : low < rLo - rngH * 0.25)))
    phase := 1
    procDir := scBar ? 1 : -1
    aVol := volume
    aBar := bar_index
    aExtBar := bar_index
    rHi := scBar ? float(na) : high
    rLo := scBar ? low : float(na)
    swpDir := 0
    testOK := false
    noC := false
inMid = phase > 0 and not na(rHi) and close < rHi - (rHi - rLo) * 0.2 and close > rLo + (rHi - rLo) * 0.2
var float flipPx = na
var int flipBar = na
xDnRLo = ta.crossunder(close, rLo)
xUpRHi = ta.crossover(close, rHi)
if phase > 0 and not na(rLo) and xDnRLo
    flipPx := rLo
    flipBar := bar_index
if phase > 0 and not na(rHi) and xUpRHi
    flipPx := rHi
    flipBar := bar_index

// ─── סשנים + AMD + Judas ────────────────────────────────────────────────────
inAsia = not na(time(timeframe.period, sesAsia, "Asia/Jerusalem"))
inLon  = not na(time(timeframe.period, sesLon,  "Asia/Jerusalem"))
inNY   = not na(time(timeframe.period, sesNY,   "Asia/Jerusalem"))
sesIdx = inLon ? 1 : inNY ? 2 : inAsia ? 0 : 3
sesName = sesIdx == 0 ? "אסיה" : sesIdx == 1 ? "לונדון" : sesIdx == 2 ? "ניו-יורק" : "מחוץ"
dayName = dayofweek == dayofweek.sunday ? "א" : dayofweek == dayofweek.monday ? "ב" : dayofweek == dayofweek.tuesday ? "ג" : dayofweek == dayofweek.wednesday ? "ד" : dayofweek == dayofweek.thursday ? "ה" : dayofweek == dayofweek.friday ? "ו" : "ש"
sesNew = sesIdx != sesIdx[1]
var float orH = na
var float orL = na
var int orStart = na
var float prevSesH = na
var float prevSesL = na
var float curSesH = na
var float curSesL = na
if sesNew
    prevSesH := curSesH
    prevSesL := curSesL
    curSesH := high
    curSesL := low
    orH := high
    orL := low
    orStart := bar_index
else
    curSesH := math.max(nz(curSesH, high), high)
    curSesL := math.min(nz(curSesL, low), low)
orBars = math.max(1, math.round(orMin * 60 / timeframe.in_seconds()))
inOR = not na(orStart) and bar_index - orStart < orBars
if inOR and not sesNew
    orH := math.max(orH, high)
    orL := math.min(orL, low)
judasBull = mLiq and not inOR and not na(orL) and low < orL and close > orL and close > open
judasBear = mLiq and not inOR and not na(orH) and high > orH and close < orH and close < open
var string amdPh = "A"
if sesNew
    amdPh := "A"
if judasBull or judasBear
    amdPh := "M"
if amdPh == "M" and (bosUp or bosDn)
    amdPh := "D"

// ─── נזילות: בריכות + Sweep ──────────────────────────────────────────────────
eqHi = not na(ph) and not na(prevPH) and math.abs(ph - prevPH) <= tol
eqLo = not na(pl) and not na(prevPL) and math.abs(pl - prevPL) <= tol
var float poolHi = na
var float poolLo = na
if mLiq and eqHi
    poolHi := (ph + prevPH) / 2
if mLiq and eqLo
    poolLo := (pl + prevPL) / 2
sweepHi = mLiq and not na(poolHi) and high > poolHi and close < poolHi
sweepLo = mLiq and not na(poolLo) and low < poolLo and close > poolLo

// ─── Premium / Discount ──────────────────────────────────────────────────────
hi100 = ta.highest(high, 100)
lo100 = ta.lowest(low, 100)
pdHi = phase > 0 ? rHi : hi100
pdLo = phase > 0 ? rLo : lo100
pdMid = (pdHi + pdLo) / 2
inPrem = close > pdMid
pdPct = pdHi != pdLo ? math.round((close - pdLo) / (pdHi - pdLo) * 100) : 50

// ─── FVG (גופים) + iFVG ─────────────────────────────────────────────────────
bodyTop = math.max(open, close)
bodyBot = math.min(open, close)
// FVG (ICT): פתיל נר 1 → פתיל נר 3; נר 2 = דחף ≥ 1.2 ATR; מרווח ≥ 0.5 ATR
pBodyTop = high[2]
pBodyBot = low[2]
dispOK = high[1] - low[1] >= atr * 1.2
bullGap = dispOK and low - pBodyTop >= atr * 0.5 and low > pBodyTop
bearGap = dispOK and pBodyBot - high >= atr * 0.5 and high < pBodyBot
var float bgTop = na
var float bgBot = na
var float sgTop = na
var float sgBot = na
var int bgState = 0
var int sgState = 0
if mFVG and bullGap
    bgTop := low
    bgBot := pBodyTop
    bgState := 1
if mFVG and bearGap
    sgTop := pBodyBot
    sgBot := high
    sgState := 1
if bgState == 1 and low <= bgBot
    bgState := 2
if sgState == 1 and high >= sgTop
    sgState := 2
ifvgBear = bgState == 2 and close < bgBot and high >= bgBot and close < open
ifvgBull = sgState == 2 and close > sgTop and low <= sgTop and close > open

// ─── SMT / iSMT ──────────────────────────────────────────────────────────────
// צמדי SMT קבועים: נאסדק↔S&P (CME), BTC↔ETH (Binance), כסף↔זהב (COMEX)
tk = syminfo.ticker
autoSym = str.contains(tk, "ETH") ? "BINANCE:BTCUSDT" : str.contains(tk, "BTC") ? "BINANCE:ETHUSDT" : str.contains(tk, "NQ") or str.contains(tk, "NAS") ? "CME_MINI:ES1!" : str.contains(tk, "ES") or str.contains(tk, "SPX") or str.contains(tk, "SPY") ? "CME_MINI:NQ1!" : str.contains(tk, "SI") or str.contains(tk, "XAG") or str.contains(tk, "SILVER") ? "COMEX:GC1!" : str.contains(tk, "GC") or str.contains(tk, "XAU") or str.contains(tk, "GOLD") ? "COMEX:SI1!" : ""
// SMT רק לצמדים הקבועים של הקורס. נכס בלי צמד (USDT.D, SOL, אלטים, דומיננס) = בלי SMT בכלל
autoSymOk = autoSym != "" and not str.contains(tk, ".D")
smtOn = mSMT and (asset2Mode == "ידני" or autoSymOk)
smtSym = asset2Mode == "אוטומטי" ? (autoSymOk ? autoSym : syminfo.tickerid) : asset2Man
a2h = request.security(smtSym, timeframe.period, high, lookahead=barmerge.lookahead_off)
a2l = request.security(smtSym, timeframe.period, low, lookahead=barmerge.lookahead_off)
hi20 = ta.highest(high, 20)
lo20 = ta.lowest(low, 20)
a2hi20 = ta.highest(a2h, 20)
a2lo20 = ta.lowest(a2l, 20)
smtBear = smtOn and high >= hi20 and a2h < a2hi20 and barstate.isconfirmed
smtBull = smtOn and low <= lo20 and a2l > a2lo20 and barstate.isconfirmed
ismtBear = smtOn and high > high[1] and close < high[1] and not (a2h > a2h[1])
ismtBull = smtOn and low < low[1] and close > low[1] and not (a2l < a2l[1])

// ─── נר בולען ────────────────────────────────────────────────────────────────

// ─── טריגר: טיסה (לונג+שורט) ─────────────────────────────────────────────────
okZone = not inMid
armL34 = (phase == 3 or phase == 4) and cIsBull
armS34 = (phase == 3 or phase == 4) and not cIsBull
flyArmL = (flyStrict ? phase == 4 : (phase == 3 or phase == 4)) and cIsBull
flyArmS = (flyStrict ? phase == 4 : (phase == 3 or phase == 4)) and not cIsBull
flyLong  = mFly and flyArmL and okZone and bosUpF and barstate.isconfirmed
flyShort = mFly and flyArmS and okZone and bosDnF and barstate.isconfirmed

// ─── טריגר: שבירת כנף (שני כיוונים) ─────────────────────────────────────────
float wingUp = na
if not na(prevPL) and not na(lastPL) and lastPL > prevPL and lastPLi > prevPLi
    wingUp := lastPL + (lastPL - prevPL) / (lastPLi - prevPLi) * (bar_index - lastPLi)
float wingDn = na
if not na(prevPH) and not na(lastPH) and lastPH < prevPH and lastPHi > prevPHi
    wingDn := lastPH + (lastPH - prevPH) / (lastPHi - prevPHi) * (bar_index - lastPHi)
wingBrkS = not na(wingUp) and close < wingUp and close[1] >= nz(wingUp[1], wingUp)
wingBrkL = not na(wingDn) and close > wingDn and close[1] <= nz(wingDn[1], wingDn)
wingShort = mWing and armS34 and okZone and wingBrkS and barstate.isconfirmed
wingLong  = mWing and armL34 and okZone and wingBrkL and barstate.isconfirmed

// ─── טריגר: אורדר בלוק ──────────────────────────────────────────────────────
sqHi = ta.highest(high, sqBars)[1]
sqLo = ta.lowest(low, sqBars)[1]
isSq = (sqHi - sqLo) <= atr * sqAtrK
var float obLTop = na
var float obLBot = na
var float obSTop = na
var float obSBot = na
var bool obLLive = false
var bool obSLive = false
bool newObL = false
bool newObS = false
if mOB and bullGap and isSq[1] and close > nz(lastPH, high)
    obLTop := low
    obLBot := pBodyTop
    obLLive := true
    newObL := true
if mOB and bearGap and isSq[1] and close < nz(lastPL, low)
    obSTop := pBodyBot
    obSBot := high
    obSLive := true
    newObS := true
if obLLive and low <= obLBot
    obLLive := false
if obSLive and high >= obSTop
    obSLive := false
obLvlL = obLTop - (obLTop - obLBot) * obDepth / 100
obLvlS = obSBot + (obSTop - obSBot) * obDepth / 100
obLong  = mOB and obLLive and msDir >= 0 and low <= obLvlL and close > obLTop and barstate.isconfirmed
obShort = mOB and obSLive and msDir <= 0 and high >= obLvlS and close < obSBot and barstate.isconfirmed
if obLong
    obLLive := false
if obShort
    obSLive := false

// ─── טריגר: W/M + צבת ───────────────────────────────────────────────────────
var float wNeck = na
var float wLow2 = na
var int wState = 0
var float mNeck = na
var float mHigh2 = na
var int mState = 0
if mWM and not na(pl) and not na(prevPL) and not na(lastPHi) and lastPHi > prevPLi and math.abs(pl - prevPL) <= tol * 2
    wNeck := lastPH
    wLow2 := pl
    wState := 1
if mWM and not na(ph) and not na(prevPH) and not na(lastPLi) and lastPLi > prevPHi and math.abs(ph - prevPH) <= tol * 2
    mNeck := lastPL
    mHigh2 := ph
    mState := 1
xUpW = ta.crossover(close, wNeck)
xDnM = ta.crossunder(close, mNeck)
wSig = wState == 1 and not na(wNeck) and xUpW and barstate.isconfirmed
mSig = mState == 1 and not na(mNeck) and xDnM and barstate.isconfirmed
if wSig
    wState := 2
if mSig
    mState := 2
twzBull = mWM and math.abs(low - low[1]) <= twzTol and close[1] < open[1] and close > open and (close - open) >= (high - low) * 0.5 and close > close[1]
twzBear = mWM and math.abs(high - high[1]) <= twzTol and close[1] > open[1] and close < open and (open - close) >= (high - low) * 0.5 and close < close[1]

// ─── טריגר: מונטה קרלו ──────────────────────────────────────────────────────
var float legA = na
var float legB = na
var float legC = na
if not na(ph) and not na(lastPL) and ph > lastPL
    legC := legB
    legB := legA
    legA := (ph - lastPL) / lastPL * 100
mcAvg = not na(legA) ? (legA + nz(legB, legA) + nz(legC, nz(legB, legA))) / 3 : na
mcProj = mMC and not na(mcAvg) and not na(lastPL) ? lastPL * (1 + mcAvg / 100) : na
mcBrk = not na(lastPH) ? lastPH * 1.015 : na
var int mcHeld = 0
mcHeld := mMC and not na(mcBrk) and close > mcBrk ? mcHeld + 1 : 0

// ─── מד 4 הרמזים ────────────────────────────────────────────────────────────
var int lastClimaxBar = na
if volClimax
    lastClimaxBar := bar_index
clue1 = not na(lastClimaxBar) and bar_index - lastClimaxBar <= 60
var int bosUpCnt = 0
var int bosDnCnt = 0
if bosUp
    bosUpCnt += 1
    bosDnCnt := 0
if bosDn
    bosDnCnt += 1
    bosUpCnt := 0
clue2 = (msDir > 0 ? bosUpCnt : bosDnCnt) >= 2
clue3 = msDir > 0 ? close > close[10] and volRank < 50 : close < close[10] and volRank < 50
var bool flipHeld = false
if bosUp
    flipHeld := false
if msDir > 0 and not na(lastPH[1]) and low <= lastPH[1] + tol and close > lastPH[1]
    flipHeld := true
if msDir < 0 and not na(lastPL[1]) and high >= lastPL[1] - tol and close < lastPL[1]
    flipHeld := true
clue4 = flipHeld
clues = (clue1 ? 1 : 0) + (clue2 ? 1 : 0) + (clue3 ? 1 : 0) + (clue4 ? 1 : 0)

// ─── קונפלואנס ──────────────────────────────────────────────────────────────

// ─── מנוע בקטסט ─────────────────────────────────────────────────────────────
buf = stopBuf / 100.0
var int fN = 0
var int fW = 0
var int wN = 0
var int wW = 0
var int oN = 0
var int oW = 0
var int wmN = 0
var int wmW = 0
var int[] sesN = array.new_int(4, 0)
var int[] sesW = array.new_int(4, 0)
f_open(float stopPx, bool isLong) => isLong ? close + (close - stopPx) * targetR : close - (stopPx - close) * targetR
var int fSt = 0
var float fS = na
var float fT = na
var bool fL = true
var int fSes = 0
var int wSt = 0
var float wS = na
var float wT = na
var bool wL = true
var int wSes2 = 0
var int oSt = 0
var float oS = na
var float oT = na
var bool oL = true
var int oSes = 0
var int wmSt = 0
var float wmS = na
var float wmT = na
var bool wmL = true
var int wmSes = 0
if (flyLong or flyShort) and fSt == 0 and inBT and btFly
    fL := flyLong
    st = fL ? math.min(nz(cExt, low), nz(lastPL, low)) * (1 - buf) : math.max(nz(cExt, high), nz(lastPH, high)) * (1 + buf)
    ok = fL ? close > st : close < st
    if ok
        fSt := 1
        fS := st
        fT := f_open(st, fL)
        fN += 1
        fSes := sesIdx
        array.set(sesN, sesIdx, array.get(sesN, sesIdx) + 1)
if fSt == 1
    hitS = fL ? low <= fS : high >= fS
    hitT = fL ? high >= fT : low <= fT
    if hitS
        fSt := 0
    else if hitT
        fW += 1
        array.set(sesW, fSes, array.get(sesW, fSes) + 1)
        fSt := 0
if (wingShort or wingLong) and wSt == 0 and inBT and btWing
    wL := wingLong
    st = wL ? nz(lastPL, low) * (1 - buf) : nz(lastPH, high) * (1 + buf)
    ok = wL ? close > st : close < st
    if ok
        wSt := 1
        wS := st
        wT := f_open(st, wL)
        wN += 1
        wSes2 := sesIdx
        array.set(sesN, sesIdx, array.get(sesN, sesIdx) + 1)
if wSt == 1
    hitS = wL ? low <= wS : high >= wS
    hitT = wL ? high >= wT : low <= wT
    if hitS
        wSt := 0
    else if hitT
        wW += 1
        array.set(sesW, wSes2, array.get(sesW, wSes2) + 1)
        wSt := 0
if (obLong or obShort) and oSt == 0 and inBT and btOB
    oL := obLong
    st = oL ? obLBot * (1 - buf) : obSTop * (1 + buf)
    ok = oL ? close > st : close < st
    if ok
        oSt := 1
        oS := st
        oT := f_open(st, oL)
        oN += 1
        oSes := sesIdx
        array.set(sesN, sesIdx, array.get(sesN, sesIdx) + 1)
if oSt == 1
    hitS = oL ? low <= oS : high >= oS
    hitT = oL ? high >= oT : low <= oT
    if hitS
        oSt := 0
    else if hitT
        oW += 1
        array.set(sesW, oSes, array.get(sesW, oSes) + 1)
        oSt := 0
if (wSig or mSig) and wmSt == 0 and inBT and btWM
    wmL := wSig
    st = wmL ? nz(wLow2, low) * (1 - buf) : nz(mHigh2, high) * (1 + buf)
    ok = wmL ? close > st : close < st
    if ok
        wmSt := 1
        wmS := st
        wmT := f_open(st, wmL)
        wmN += 1
        wmSes := sesIdx
        array.set(sesN, sesIdx, array.get(sesN, sesIdx) + 1)
if wmSt == 1
    hitS = wmL ? low <= wmS : high >= wmS
    hitT = wmL ? high >= wmT : low <= wmT
    if hitS
        wmSt := 0
    else if hitT
        wmW += 1
        array.set(sesW, wmSes, array.get(sesW, wmSes) + 1)
        wmSt := 0

// ─── צ'ק-ליסט ────────────────────────────────────────────────────────────────
ckSpring = (phase == 3 or phase == 4) and cIsBull
ckUT = (phase == 3 or phase == 4) and not cIsBull
ckTest = testOK
ckSes = sesIdx != 3
armDir = ckSpring ? 1 : ckUT ? -1 : 0
float ckStop = armDir == 1 ? math.min(nz(cExt, low), nz(lastPL, low)) : armDir == -1 ? math.max(nz(cExt, high), nz(lastPH, high)) : na
float ckTgt = armDir == 1 ? (phase > 0 ? rHi : nz(poolHi, high)) : armDir == -1 ? (phase > 0 ? rLo : nz(poolLo, low)) : na
ckRR = not na(ckStop) and not na(ckTgt) and math.abs(close - ckStop) > 0 ? math.abs(ckTgt - close) / math.abs(close - ckStop) : na
ckRRok = not na(ckRR) and ckRR >= 3

// ═══ מטריצת TF-ים — פאזה + כל האישורים לכל מסגרת ═══
f_state() =>
    rs = ta.rsi(close, rsiLen)
    vr = ta.percentrank(volume, 250)
    atrF = ta.atr(14)
    clx = vr >= 95
    p1 = ta.pivothigh(high, 5, 5)
    p2 = ta.pivotlow(low, 5, 5)
    var float lph = na
    var float lpl = na
    if not na(p1)
        lph := p1
    if not na(p2)
        lpl := p2
    xU = ta.crossover(close, lph)
    xD = ta.crossunder(close, lpl)
    bU = not na(lph) and xU
    bD = not na(lpl) and xD
    var int dir = 0
    if bU
        dir := 1
    if bD
        dir := -1
    lo30f = ta.lowest(low, 30)
    hi30f = ta.highest(high, 30)
    sc = clx and low <= lo30f and close[20] - close >= atrF
    bc = clx and high >= hi30f and close - close[20] >= atrF
    var int phs = 0
    var int pd = 0
    var float av = na
    var float rh = na
    var float rl = na
    var int aB = na
    var int bB = na
    var int cB = na
    var int dB = na
    var int eB = na
    var int cd = 0
    var bool tst = false
    var float sx = na
    var float sxo = na
    var float so = na
    var float eX = na
    var float eO = na
    var bool cOpen = false
    var float vHi = na
    var float vLo = na
    var int aXB = na
    rng = nz(rh - rl, 0)
    if phs == 1
        if pd == -1
            if high > rh
                rh := high
                aXB := bar_index
                rl := float(na)
            else
                rl := na(rl) ? low : math.min(rl, low)
        else
            if low < rl
                rl := low
                aXB := bar_index
                rh := float(na)
            else
                rh := na(rh) ? high : math.max(rh, high)
        arN = pd == 1 ? (not na(p1) and bar_index - 5 > aXB) : (not na(p2) and bar_index - 5 > aXB)
        if arN
            phs := 2
            bB := bar_index
        else if bar_index - aB > 40
            phs := 0
    var int sd = 0
    var float sv = na
    var float swx = na
    var int sB = na
    sp = false
    ut = false
    if phs == 2 or phs == 3 or phs == 4
        if sd == 0 and low < rl
            sd := 1
            sB := bar_index
            sv := volume
            swx := low
            so := high
        else if sd == 0 and high > rh
            sd := -1
            sB := bar_index
            sv := volume
            swx := high
            so := low
        else if sd == 1
            sv := math.max(sv, volume)
            if low < swx
                swx := low
                so := high
            if close > rl
                if (phs == 3 and cd > 0) or sv >= av * 0.8 or vr >= 95
                    sp := true
                sd := 0
            else if close < rl - rng * 0.25 or bar_index - sB > 20
                phs := 5
                cd := -1
                eX := swx
                eO := so
                eB := bar_index
                sd := 0
        else if sd == -1
            sv := math.max(sv, volume)
            if high > swx
                swx := high
                so := low
            if close < rh
                if (phs == 3 and cd < 0) or sv >= av * 0.8 or vr >= 95
                    ut := true
                sd := 0
            else if close > rh + rng * 0.25 or bar_index - sB > 20
                phs := 5
                cd := 1
                eX := swx
                eO := so
                eB := bar_index
                sd := 0
        if phs == 2 and bar_index - bB > 200
            phs := 0
    if sp or ut
        nd = sp ? 1 : -1
        sameC = phs == 3 and cd != 0 and (cd > 0) == (nd > 0)
        keepOld = sameC and not na(sx) and (sp ? swx >= sx : swx <= sx)
        cd := nd
        phs := 3
        cB := bar_index
        sx := keepOld ? sx : swx
        sxo := keepOld ? sxo : so
        tst := sameC ? tst : false
        cOpen := false
    vC = sd == 0 and rng > 0 and low >= rl and high <= rh and not (sp or ut) and (volume >= av * 0.8 or vr >= 95)
    if vC and phs == 2
        cd := 0
        cOpen := true
        phs := 3
        cB := bar_index
        vHi := high
        vLo := low
        sx := float(na)
        sxo := float(na)
        tst := false
    else if vC and phs == 3 and cOpen
        vHi := math.max(vHi, high)
        vLo := math.min(vLo, low)
    if phs == 3 and cOpen
        lU = not na(p2) and bar_index - 5 > cB and p2 > vLo and p2 < vHi and volume[5] < av
        lD = not na(p1) and bar_index - 5 > cB and p1 < vHi and p1 > vLo and volume[5] < av
        if close > vHi or (lU and not lD)
            cd := 2
            cOpen := false
            sx := vLo
            sxo := vHi
        else if close < vLo or (lD and not lU)
            cd := -2
            cOpen := false
            sx := vHi
            sxo := vLo
    if (phs == 3 or phs == 4) and not cOpen and cd != 0 and not na(sx)
        if cd > 0 and not na(p2) and bar_index - 5 > cB and p2 > sx and volume[5] < av
            tst := true
        if cd < 0 and not na(p1) and bar_index - 5 > cB and p1 < sx and volume[5] < av
            tst := true
    if (phs == 3 or phs == 4) and not na(sx) and vr <= 25
        if cd > 0 and math.abs(low - sx) <= atrF * 0.5
            tst := true
        if cd < 0 and math.abs(high - sx) <= atrF * 0.5
            tst := true
    var int fireB = na
    var int fd = 0
    if phs == 3 and cd != 0 and (cd > 0 ? (bU or close > sxo) : (bD or close < sxo))
        phs := 4
        dB := bar_index
        fireB := bar_index
        fd := cd
    if (phs == 3 or phs == 4) and sd == 0 and not na(sx) and (cd > 0 ? close < sx : close > sx)
        brk = cd > 0 ? close < rl - rng * 0.25 : close > rh + rng * 0.25
        cd := -cd
        if brk
            phs := 5
            eB := bar_index
            eX := cd > 0 ? high : low
            eO := cd > 0 ? low : high
        else
            phs := 4
            dB := bar_index
            cB := bar_index
            fireB := bar_index
            fd := cd
            sxo := cd > 0 ? low : high
            sx := cd > 0 ? nz(lpl, low) : nz(lph, high)
            tst := false
        sd := 0
    eBrk2 = cd > 0 ? (close > rh + rng * 0.25 or (close > rh and close[1] > rh and low > rh)) : (close < rl - rng * 0.25 or (close < rl and close[1] < rl and high < rl))
    if phs == 4 and eBrk2
        phs := 5
        eB := bar_index
        eX := cd > 0 ? high : low
        eO := cd > 0 ? low : high
        sd := 0
    if phs == 4 and bar_index - dB > 60
        phs := 3
        cB := bar_index
        sd := 0
    if phs == 5 and bar_index - eB > 100
        phs := 0
    if phs == 5 and (na(eX) or (cd > 0 ? high > eX : low < eX))
        eX := cd > 0 ? high : low
        eO := cd > 0 ? low : high
    if phs == 5 and not na(eB) and bar_index - eB <= 20 and (cd > 0 ? close < rh : close > rl)
        cd := -cd
        sx := eX
        sxo := nz(eO, cd > 0 ? high : low)
        cB := bar_index
        phs := 3
        sd := 0
        tst := false
    if (sc or bc) and (phs == 0 or ((phs == 5 and not na(eB) and bar_index - eB > 20 or phs == 2) and (bc ? high > rh + rng * 0.25 : low < rl - rng * 0.25)))
        phs := 1
        pd := sc ? 1 : -1
        av := volume
        aB := bar_index
        aXB := bar_index
        rh := sc ? float(na) : high
        rl := sc ? low : float(na)
        cd := 0
        tst := false
        sx := na
        sd := 0
    var int lastClx = na
    if clx
        lastClx := bar_index
    c1 = not na(lastClx) and bar_index - lastClx <= 60
    var int upCnt = 0
    var int dnCnt = 0
    if bU
        upCnt += 1
        dnCnt := 0
    if bD
        dnCnt += 1
        upCnt := 0
    c2 = (dir > 0 ? upCnt : dnCnt) >= 2
    c3 = dir > 0 ? close > close[10] and vr < 50 : close < close[10] and vr < 50
    var bool flipH = false
    if bU
        flipH := false
    if dir > 0 and not na(lph[1]) and low <= lph[1] + atrF * 0.25 and close > lph[1]
        flipH := true
    if dir < 0 and not na(lpl[1]) and high >= lpl[1] - atrF * 0.25 and close < lpl[1]
        flipH := true
    c4 = flipH
    clB = (c1 ? 1 : 0) + (c2 ? 2 : 0) + (c3 ? 4 : 0) + (c4 ? 8 : 0)
    zn = phs > 0 and not na(rh) ? (close < rh - (rh - rl) * 0.2 and close > rl + (rh - rl) * 0.2 ? 0 : 1) : -1
    var float pl1 = na
    var float pl2 = na
    var float phB = na
    var float ph1 = na
    var float ph2 = na
    var float plB = na
    var int wm = 0
    if (not na(p1) or not na(p2)) and math.abs(wm) == 2
        wm := 0
    if not na(p2)
        pl2 := pl1
        pl1 := p2
        phB := lph
    if not na(p1)
        ph2 := ph1
        ph1 := p1
        plB := lpl
    wB = not na(pl1) and not na(pl2) and not na(phB) and math.abs(pl1 - pl2) <= atrF * 0.5 and phB > math.max(pl1, pl2)
    mB = not na(ph1) and not na(ph2) and not na(plB) and math.abs(ph1 - ph2) <= atrF * 0.5 and plB < math.min(ph1, ph2)
    xW = ta.crossover(close, nz(phB, close))
    xM = ta.crossunder(close, nz(plB, close))
    if wB and wm == 0
        wm := 1
    if mB and wm == 0
        wm := -1
    if wm == 1 and xW
        wm := 2
    if wm == -1 and xM
        wm := -2
    var int tS = 0
    var float tStop = na
    var float tTgt = na
    var int tDir = 0
    var int bN = 0
    var int bW = 0
    if tS == 1
        hS = tDir > 0 ? low <= tStop : high >= tStop
        hT = tDir > 0 ? high >= tTgt : low <= tTgt
        if hS
            tS := 0
        else if hT
            bW += 1
            tS := 0
    if not na(fireB) and fireB == bar_index and tS == 0 and inBT
        tDir := fd
        tStop := fd > 0 ? rl : rh
        if fd > 0 ? close > tStop : close < tStop
            tS := 1
            tTgt := fd > 0 ? close + (close - tStop) * targetR : close - (tStop - close) * targetR
            bN += 1
    twB = math.abs(low - low[1]) <= twzTol and close[1] < open[1] and close > open and (close - open) >= (high - low) * 0.5 and close > close[1]
    twS = math.abs(high - high[1]) <= twzTol and close[1] > open[1] and close < open and (open - close) >= (high - low) * 0.5 and close < close[1]
    var int twLast = 0
    var int twBar = na
    if twB
        twLast := 1
        twBar := bar_index
    if twS
        twLast := -1
        twBar := bar_index
    tw = not na(twBar) and bar_index - twBar <= 3 and zn == 1 ? twLast : 0
    [phs, dir, cd, na(fireB) ? -1 : bar_index - fireB, fd, tst ? 1 : 0, zn, clB, wm, bN, bW, tw, rs]
[phD, dirD, cdD, agoD, fdD, tsD, znD, clD, wmD, bnD, bwD, twD, rsD] = request.security(syminfo.tickerid, "D", f_state(), lookahead=barmerge.lookahead_off)
[ph4, dir4, cd4, ago4, fd4, ts4, zn4, cl4, wm4, bn4, bw4, tw4, rs4] = request.security(syminfo.tickerid, "240", f_state(), lookahead=barmerge.lookahead_off)
[ph1h, dir1h, cd1h, ago1h, fd1h, ts1h, zn1h, cl1h, wm1h, bn1h, bw1h, tw1h, rs1h] = request.security(syminfo.tickerid, "60", f_state(), lookahead=barmerge.lookahead_off)
[ph15, dir15, cd15, ago15, fd15, ts15, zn15, cl15, wm15, bn15, bw15, tw15, rs15] = request.security(syminfo.tickerid, "15", f_state(), lookahead=barmerge.lookahead_off)
[ph5m, dir5m, cd5m, ago5m, fd5m, ts5m, zn5m, cl5m, wm5m, bn5m, bw5m, tw5m, rs5m] = request.security(syminfo.tickerid, "5", f_state(), lookahead=barmerge.lookahead_off)
// כמה נרות יש לכל מסגרת גבוהה מטווח הגרף הנוכחי — פחות מהמינימום = המנוע מורעב, מסמנים "?" במקום לנחש
htfMinBars = input.int(400, "מינימום נרות למסגרת גבוהה (פחות = '?' מעט נתונים)", minval=50, maxval=3000, group=gT)
nbD = request.security(syminfo.tickerid, "D", bar_index, lookahead=barmerge.lookahead_off)
nb4 = request.security(syminfo.tickerid, "240", bar_index, lookahead=barmerge.lookahead_off)
nb1h = request.security(syminfo.tickerid, "60", bar_index, lookahead=barmerge.lookahead_off)
nb15 = request.security(syminfo.tickerid, "15", bar_index, lookahead=barmerge.lookahead_off)
nb5m = request.security(syminfo.tickerid, "5", bar_index, lookahead=barmerge.lookahead_off)
f_starveTip(int nb, string tfn) => "מעט נתונים: " + str.tostring(nb + 1) + " נרות במסגרת " + tfn + " מתוך טווח הגרף הנוכחי (מינימום " + str.tostring(htfMinBars) + "). הפאזה והכיוון כאן לא אמינים — פתח גרף " + tfn + " לקריאה אמיתית"
f_phN(int p) => p == 1 ? "A" : p == 2 ? "B" : p == 3 ? "C" : p == 4 ? "D" : p == 5 ? "E" : "—"
f_dirN(int d) => d > 0 ? "שורי" : d < 0 ? "דובי" : "—"
f_trigN(int p, int cd2, int ago2, int fd2) => ago2 >= 0 and ago2 <= 40 ? (fd2 > 0 ? "נורה ↑" : "נורה ↓") : p == 3 ? (cd2 > 0 ? "✈ חמוש" : cd2 < 0 ? "כנף חמוש" : "חמוש") : p == 4 ? "תפיסת כיוון" : "—"
f_wmN(int v) => v == 1 ? "W נבנית" : v == -1 ? "M נבנית" : v == 2 ? "W✓" : v == -2 ? "M✓" : "—"
f_cluCnt(int b) => b % 2 + math.floor(b / 2) % 2 + math.floor(b / 4) % 2 + math.floor(b / 8) % 2
f_cluTip(int b) => "4 רמזי הכיוון:\n1· בלימה בווליום ענק לאחרונה: " + (b % 2 == 1 ? "✓" : "✗") + "\n2· שני BOS ומעלה באותו כיוון: " + (math.floor(b / 2) % 2 == 1 ? "✓" : "✗") + "\n3· מתקדם בקלות על ווליום נמוך: " + (math.floor(b / 4) % 2 == 1 ? "✓" : "✗") + "\n4· הפליפ האחרון מחזיק: " + (math.floor(b / 8) % 2 == 1 ? "✓" : "✗")
pct(int w2, int n2) => n2 > 0 ? str.tostring(math.round(w2 * 100.0 / n2)) + "%" : "—"
plot(clues, "רמזים (0-4)", color.new(color.gray, 100), editable=false)
vAnch = tblLayout == "טלפון" ? "bottom" : tblShiftY > 0 ? "top" : tblShiftY < 0 ? "bottom" : str.contains(tblPosS, "עליון") ? "top" : str.contains(tblPosS, "תחתון") ? "bottom" : "middle"
hAnch = tblLayout == "טלפון" ? "center" : tblShiftX > 0 ? "left" : tblShiftX < 0 ? "right" : str.contains(tblPosS, "שמאל") ? "left" : str.contains(tblPosS, "ימין") ? "right" : "center"
tblPos = vAnch == "top" ? (hAnch == "left" ? position.top_left : hAnch == "right" ? position.top_right : position.top_center) : vAnch == "bottom" ? (hAnch == "left" ? position.bottom_left : hAnch == "right" ? position.bottom_right : position.bottom_center) : (hAnch == "left" ? position.middle_left : hAnch == "right" ? position.middle_right : position.middle_center)
cx = tblShiftX > 0 ? tblShiftX : 0
cy = tblShiftY > 0 ? tblShiftY : 0
szL = tblLayout == "טלפון" ? size.small : tblSizeS == "זעיר" ? size.tiny : tblSizeS == "קטן" ? size.small : tblSizeS == "רגיל" ? size.normal : size.large
szN = tblLayout == "טלפון" ? size.tiny : tblSizeS == "זעיר" ? size.tiny : tblSizeS == "קטן" ? size.small : tblSizeS == "רגיל" ? size.normal : size.normal
szS = tblLayout == "טלפון" ? size.tiny : tblSizeS == "זעיר" ? size.tiny : tblSizeS == "קטן" ? size.small : tblSizeS == "רגיל" ? size.small : size.normal
var table t = table.new(tblPos, 32, 40, border_width=1, frame_color=color.rgb(19, 23, 34), frame_width=1, border_color=color.rgb(19, 23, 34))
BG  = color.rgb(19, 23, 34)
BG2 = color.rgb(28, 33, 46)
HDR = color.rgb(52, 58, 75)
SEP = color.rgb(40, 46, 60)
TXT = color.rgb(235, 238, 245)
MUT = color.rgb(160, 168, 185)
GRN = color.rgb(8, 153, 129)
RED = color.rgb(242, 54, 69)
f_phBG(int p) => p == 1 ? color.rgb(0, 121, 107) : p == 2 ? color.rgb(84, 92, 110) : p == 3 ? color.rgb(198, 40, 40) : p == 4 ? color.rgb(21, 101, 192) : p == 5 ? color.rgb(46, 125, 50) : BG2
f_cell(int c, int r, string s2, color bg, color tx, string sz) =>
    table.cell(t, c + cx, r + cy, s2, bgcolor=bg, text_color=tx, text_size=sz)
    true
f_cellT(int c, int r, string s2, color bg, color tx, string sz, string tip) =>
    table.cell(t, c + cx, r + cy, s2, bgcolor=bg, text_color=tx, text_size=sz, tooltip=tip)
    true
f_spacers(int lastCol, int lastRow) =>
    if tblShiftX > 0
        for sc = 0 to tblShiftX - 1
            table.cell(t, sc, cy, "", width=3, bgcolor=color.new(color.black, 100))
    if tblShiftX < 0
        for sc = 1 to -tblShiftX
            table.cell(t, lastCol + cx + sc, cy, "", width=3, bgcolor=color.new(color.black, 100))
    if tblShiftY > 0
        for sr = 0 to tblShiftY - 1
            table.cell(t, cx, sr, "", height=3, bgcolor=color.new(color.black, 100))
    if tblShiftY < 0
        for sr = 1 to -tblShiftY
            table.cell(t, cx, lastRow + cy + sr, "", height=3, bgcolor=color.new(color.black, 100))
    true
f_tri(int c, int r, int v, color rb) =>
    f_cell(c, r, v == 1 ? "✓" : v == 0 ? "✗" : "—", v == 1 ? GRN : v == 0 ? color.new(RED, 45) : rb, v >= 0 ? color.white : MUT, szN)
    true
rsiV = ta.rsi(close, rsiLen)
f_rsiTxt(float r) => na(r) ? "—" : str.tostring(r, "#") + (r >= rsiHi ? " ↓" : r <= rsiLo ? " ↑" : "")
f_rsiBG(float r, color base) => na(r) ? base : r >= rsiHi ? color.new(RED, 40) : r <= rsiLo ? color.new(GRN, 40) : base
tipRsi = "RSI " + str.tostring(rsiLen) + " (הקורס: הרגיל, רמות " + str.tostring(rsiHi) + "/" + str.tostring(rsiLo) + "). ↑ = מתחת ל-" + str.tostring(rsiLo) + " (מכור מדי → צפי לעלייה, לונג), ↓ = מעל " + str.tostring(rsiHi) + " (קנוי מדי → צפי לירידה, שורט). אישור בקצה של אזור עניין, לא טריגר. 🎬 25-9, 35-1"
f_rowW(int r, string nm, int p, int d, string trg, int cd2, int ts2, int zn2, int clB2, int parentPh, int wm2, int bn2, int bw2, int tw2, float rs2) =>
    inSyn = (parentPh == 3 or parentPh == 4) and p >= 3
    rb = inSyn ? color.rgb(66, 55, 10) : r % 2 == 0 ? BG : BG2
    f_cell(0, r, nm, rb, TXT, szL)
    f_cell(1, r, f_phN(p), f_phBG(p), color.white, szL)
    f_cell(2, r, f_dirN(d), rb, d > 0 ? GRN : d < 0 ? RED : MUT, szN)
    f_cell(3, r, trg, rb, trg == "—" ? MUT : color.yellow, szN)
    f_cell(4, r, cd2 == 2 ? "V↑" : cd2 == -2 ? "V↓" : cd2 > 0 ? "S" : cd2 < 0 ? "U" : p == 3 ? "V" : "—", cd2 > 0 ? GRN : cd2 < 0 ? color.new(color.orange, 25) : p == 3 ? color.new(color.purple, 25) : rb, cd2 != 0 or p == 3 ? color.white : MUT, szN)
    f_tri(5, r, p >= 3 ? ts2 : -1, rb)
    f_tri(6, r, zn2, rb)
    f_tri(7, r, cd2 > 0 ? (d >= 0 ? 1 : 0) : cd2 < 0 ? (d <= 0 ? 1 : 0) : -1, rb)
    f_cellT(8, r, str.tostring(f_cluCnt(clB2)) + "/4", rb, f_cluCnt(clB2) >= 3 ? color.yellow : TXT, szN, f_cluTip(clB2))
    f_cell(9, r, parentPh == 0 ? "—" : "בתוך " + f_phN(parentPh), rb, inSyn ? color.yellow : MUT, szN)
    f_cell(10, r, f_wmN(wm2), rb, math.abs(wm2) == 2 ? color.yellow : wm2 != 0 ? TXT : MUT, szN)
    f_cellT(11, r, bn2 > 0 ? str.tostring(bw2) + "/" + str.tostring(bn2) + " · " + pct(bw2, bn2) : "—", rb, bn2 > 0 ? TXT : MUT, szN, "בקטסט טיסה במסגרת הזו: פגיעות ביעד " + str.tostring(targetR, "#") + "R / כניסות. סטופ = קצה הטווח. מסונן לפי התקופה שבהגדרות")
    f_cellT(12, r, tw2 > 0 ? "✚ שורי" : tw2 < 0 ? "✚ דובי" : "—", rb, tw2 > 0 ? GRN : tw2 < 0 ? RED : MUT, szN, "צבת (3 נרות אחרונים): שני נרות סמוכים עם שפל/שיא זהה + נר היפוך שסוגר מעבר לשניהם. ⚠ לא מהקורס — אישור נרות")
    f_cellT(13, r, f_rsiTxt(rs2), f_rsiBG(rs2, rb), color.white, szN, tipRsi)
    true
f_colP(int c, string nm, int p, int d, string trg, int cd2, int ts2, int zn2, int clB2, int parentPh, int wm2, int bn2, int bw2, int tw2, float rs2) =>
    f_cell(c, 0, nm, HDR, TXT, szN)
    f_cell(c, 1, f_phN(p), f_phBG(p), color.white, szN)
    f_cell(c, 2, f_dirN(d), BG, d > 0 ? GRN : d < 0 ? RED : MUT, szS)
    f_cell(c, 3, trg, BG2, trg == "—" ? MUT : color.yellow, szS)
    f_cell(c, 4, cd2 == 2 ? "V↑" : cd2 == -2 ? "V↓" : cd2 > 0 ? "S" : cd2 < 0 ? "U" : p == 3 ? "V" : "—", cd2 > 0 ? GRN : cd2 < 0 ? color.new(color.orange, 25) : p == 3 ? color.new(color.purple, 25) : BG, cd2 != 0 or p == 3 ? color.white : MUT, szS)
    f_tri(c, 5, p >= 3 ? ts2 : -1, BG2)
    f_tri(c, 6, zn2, BG)
    f_tri(c, 7, cd2 > 0 ? (d >= 0 ? 1 : 0) : cd2 < 0 ? (d <= 0 ? 1 : 0) : -1, BG2)
    f_cellT(c, 8, str.tostring(f_cluCnt(clB2)) + "/4", BG, f_cluCnt(clB2) >= 3 ? color.yellow : TXT, szS, f_cluTip(clB2))
    f_cell(c, 9, parentPh == 0 ? "—" : f_phN(parentPh), BG2, MUT, szS)
    f_cell(c, 10, f_wmN(wm2), BG, math.abs(wm2) == 2 ? color.yellow : wm2 != 0 ? TXT : MUT, szS)
    f_cell(c, 11, bn2 > 0 ? str.tostring(bw2) + "/" + str.tostring(bn2) : "—", BG2, bn2 > 0 ? TXT : MUT, szS)
    f_cell(c, 12, tw2 > 0 ? "✚" : tw2 < 0 ? "✚" : "—", BG, tw2 > 0 ? GRN : tw2 < 0 ? RED : MUT, szS)
    f_cell(c, 13, f_rsiTxt(rs2), f_rsiBG(rs2, BG2), color.white, szS)
    true
f_starveW(int r, int nb, string tfn) =>
    if nb >= 0 and nb + 1 < htfMinBars
        f_cellT(1, r, "?", color.new(color.gray, 55), color.white, szL, f_starveTip(nb, tfn))
        f_cell(2, r, "—", BG, MUT, szN)
f_starveP(int c, int nb, string tfn) =>
    if nb >= 0 and nb + 1 < htfMinBars
        f_cellT(c, 1, "?", color.new(color.gray, 55), color.white, szN, f_starveTip(nb, tfn))
        f_cell(c, 2, "—", BG, MUT, szS)
if barstate.islast
    curTrig = fSt == 1 ? "✈ פתוח" : wSt == 1 ? "כנף פתוח" : oSt == 1 ? "OB פתוח" : wmSt == 1 ? "W/M פתוח" : armDir == 1 ? "✈ חמוש" : armDir == -1 ? "✈ חמוש שורט" : "—"
    tfp = timeframe.period
    isStdTF = tfp == "D" or tfp == "240" or tfp == "60" or tfp == "15" or tfp == "5"
    chartClB = (clue1 ? 1 : 0) + (clue2 ? 2 : 0) + (clue3 ? 4 : 0) + (clue4 ? 8 : 0)
    chartWm = wState == 2 ? 2 : wState == 1 ? 1 : mState == 2 ? -2 : mState == 1 ? -1 : 0
    chartTw = okZone and (twzBull or twzBull[1] or twzBull[2]) ? 1 : okZone and (twzBear or twzBear[1] or twzBear[2]) ? -1 : 0
    synCnt = ((ph4 >= 3 ? 1 : 0) + (ph1h >= 3 ? 1 : 0) + (ph15 >= 3 ? 1 : 0) + (ph5m >= 3 ? 1 : 0))
    bosPend = armDir == 1 ? "BOS: סגירה מעל " + str.tostring(lastPH, format.mintick) : armDir == -1 ? "BOS: סגירה מתחת " + str.tostring(lastPL, format.mintick) : "BOS: —"
    if tblLayout == "טלפון"
        f_spacers(6, 20)
        f_cell(0, 0, "TF", HDR, TXT, szN)
        f_cell(0, 1, "פאזה", HDR, TXT, szS)
        f_cell(0, 2, "מרחב", HDR, TXT, szS)
        f_cell(0, 3, "טריגר", HDR, TXT, szS)
        f_cell(0, 4, "S/U", HDR, TXT, szS)
        f_cell(0, 5, "Test", HDR, TXT, szS)
        f_cell(0, 6, "קצה", HDR, TXT, szS)
        f_cell(0, 7, "עם מרחב", HDR, TXT, szS)
        f_cellT(0, 8, "רמזים", HDR, TXT, szS, "4 רמזי הכיוון — רחף על התא לפירוט")
        f_cell(0, 9, "בתוך", HDR, TXT, szS)
        f_cell(0, 10, "W/M", HDR, TXT, szS)
        f_cell(0, 11, "✈ בק'", HDR, TXT, szS)
        f_cell(0, 12, "צבת", HDR, TXT, szS)
        f_cellT(0, 13, "RSI", HDR, TXT, szS, tipRsi)
        f_colP(1, "D", phD, dirD, tfp == "D" ? curTrig : f_trigN(phD, cdD, agoD, fdD), cdD, tsD, znD, clD, 0, wmD, bnD, bwD, twD, rsD)
        f_colP(2, "4H", ph4, dir4, tfp == "240" ? curTrig : f_trigN(ph4, cd4, ago4, fd4), cd4, ts4, zn4, cl4, phD, wm4, bn4, bw4, tw4, rs4)
        f_colP(3, "1H", ph1h, dir1h, tfp == "60" ? curTrig : f_trigN(ph1h, cd1h, ago1h, fd1h), cd1h, ts1h, zn1h, cl1h, ph4, wm1h, bn1h, bw1h, tw1h, rs1h)
        f_colP(4, "15m", ph15, dir15, tfp == "15" ? curTrig : f_trigN(ph15, cd15, ago15, fd15), cd15, ts15, zn15, cl15, ph1h, wm15, bn15, bw15, tw15, rs15)
        f_colP(5, "5m", ph5m, dir5m, tfp == "5" ? curTrig : f_trigN(ph5m, cd5m, ago5m, fd5m), cd5m, ts5m, zn5m, cl5m, ph15, wm5m, bn5m, bw5m, tw5m, rs5m)
        f_starveP(1, nbD, "D")
        f_starveP(2, nb4, "4H")
        f_starveP(3, nb1h, "1H")
        f_starveP(4, nb15, "15m")
        f_starveP(5, nb5m, "5m")
        if not isStdTF
            f_colP(6, tfp, phase, msDir, curTrig, armDir, ckTest ? 1 : 0, phase > 0 ? (okZone ? 1 : 0) : -1, chartClB, 0, chartWm, fN, fW, chartTw, rsiV)
        f_cell(0, 14, "הגרף (" + tfp + ")", HDR, TXT, szS)
        f_cell(1, 14, (armDir == 1 ? "✈ לונג חמוש" : armDir == -1 ? "✈ שורט חמוש" : "אין סטאפ") + " · RSI " + f_rsiTxt(rsiV), HDR, armDir != 0 ? color.yellow : MUT, szS)
        f_cell(3, 14, "יחס 1:3", HDR, TXT, szS)
        f_cell(4, 14, (na(ckRR) ? "—" : str.tostring(ckRR, "#.#")) + (ckRRok ? " ✓" : " ✗"), ckRRok ? GRN : color.new(RED, 45), color.white, szS)
        f_cell(0, 15, "סשן", BG2, TXT, szS)
        f_cell(1, 15, sesName + (ckSes ? " ✓" : " ✗"), ckSes ? GRN : color.new(RED, 45), color.white, szS)
        f_cell(3, 15, "מיקום", BG2, TXT, szS)
        f_cell(4, 15, str.tostring(pdPct) + "% " + (inPrem ? "פרימיום" : "דיסקאונט"), BG2, TXT, szS)
        f_cell(0, 16, "AMD", BG, TXT, szS)
        f_cell(1, 16, amdPh + " · סינרגיה " + str.tostring(synCnt) + "/4", BG, synCnt >= 3 ? color.yellow : TXT, szS)
        f_cell(3, 16, "BOS", BG, TXT, szS)
        f_cell(4, 16, bosPend, BG, color.yellow, szS)
        f_cell(0, 17, "בקטסט " + str.tostring(targetR, "#") + "R", HDR, TXT, szS)
        f_cell(1, 17, btPeriod, HDR, MUT, szS)
        f_cell(3, 17, "✈ טיסה", HDR, TXT, szS)
        f_cell(4, 17, str.tostring(fW) + "/" + str.tostring(fN) + " · " + pct(fW, fN), HDR, TXT, szS)
        f_cell(0, 18, "כנף", BG2, TXT, szS)
        f_cell(1, 18, str.tostring(wW) + "/" + str.tostring(wN) + " · " + pct(wW, wN), BG2, TXT, szS)
        f_cell(3, 18, "OB · W/M", BG2, TXT, szS)
        f_cell(4, 18, str.tostring(oW) + "/" + str.tostring(oN) + " · " + str.tostring(wmW) + "/" + str.tostring(wmN), BG2, TXT, szS)
        f_cell(0, 19, "סשנים", BG, MUT, szS)
        f_cell(1, 19, "לונ' " + str.tostring(array.get(sesW, 1)) + "/" + str.tostring(array.get(sesN, 1)) + " · ניו' " + str.tostring(array.get(sesW, 2)) + "/" + str.tostring(array.get(sesN, 2)) + " · אס' " + str.tostring(array.get(sesW, 0)) + "/" + str.tostring(array.get(sesN, 0)), BG, TXT, szS)
        for pr = 14 to 18
            table.merge_cells(t, cx + 1, cy + pr, cx + 2, cy + pr)
            table.merge_cells(t, cx + 4, cy + pr, cx + 5, cy + pr)
        table.merge_cells(t, cx + 1, cy + 19, cx + 5, cy + 19)
    else
        f_spacers(14, 10)
        f_cell(0, 0, "TF", HDR, TXT, szN)
        f_cell(1, 0, "פאזה", HDR, TXT, szN)
        f_cellT(2, 0, "מרחב", HDR, TXT, szN, "מרחב קונים/מוכרים (12-5): כיוון ה-BOS האחרון. שורי = מרחב קונים, דובי = מרחב מוכרים")
        f_cell(3, 0, "טריגר", HDR, TXT, szN)
        f_cellT(4, 0, "S/U", HDR, TXT, szN, "ספרינג (S) / אפ-טראסט (U) — כיוון ההכרעה של פאזה C · V = C לפי ווליום בלי ניעור (כיוון עוד לא ידוע) → V↑/V↓ אחרי שה-LPS קבע כיוון")
        f_cell(5, 0, "Test", HDR, TXT, szN)
        f_cellT(6, 0, "קצה", HDR, TXT, szN, "אזור עניין (48-1): המחיר ב-20% העליונים או התחתונים של הטווח (אייס↔קריק). ✗ = במרכז = שטח מת")
        f_cellT(7, 0, "עם מרחב", HDR, TXT, szN, "ההכרעה (S/U) תואמת לכיוון המרחב: ספרינג במרחב קונים ✓, UT במרחב מוכרים ✓. לא קשור לעמודת 'קצה הטווח'")
        f_cellT(8, 0, "רמזים", HDR, TXT, szN, "4 רמזי הכיוון של הקורס — רחף על התא בשורה לפירוט מלא")
        f_cell(9, 0, "בתוך", HDR, TXT, szN)
        f_cellT(10, 0, "W/M", HDR, TXT, szN, "דאבל בוטום/טופ: נבנית = שני שפלים/שיאים שווים; ✓ = סגירה מעבר לצוואר")
        f_cellT(11, 0, "✈ בק' TF", HDR, TXT, szN, "טיסה בכל מסגרת: פגיעות/כניסות · אחוז. מסונן לפי 'תקופה אחרונה' / טווח תאריכים")
        f_cellT(12, 0, "צבת", HDR, TXT, szN, "צבת בכל מסגרת — שני נרות סמוכים עם שפל/שיא זהה + נר היפוך. לא מהקורס")
        f_cellT(13, 0, "RSI", HDR, TXT, szN, tipRsi)
        f_rowW(1, "D", phD, dirD, tfp == "D" ? curTrig : f_trigN(phD, cdD, agoD, fdD), cdD, tsD, znD, clD, 0, wmD, bnD, bwD, twD, rsD)
        f_rowW(2, "4H", ph4, dir4, tfp == "240" ? curTrig : f_trigN(ph4, cd4, ago4, fd4), cd4, ts4, zn4, cl4, phD, wm4, bn4, bw4, tw4, rs4)
        f_rowW(3, "1H", ph1h, dir1h, tfp == "60" ? curTrig : f_trigN(ph1h, cd1h, ago1h, fd1h), cd1h, ts1h, zn1h, cl1h, ph4, wm1h, bn1h, bw1h, tw1h, rs1h)
        f_rowW(4, "15m", ph15, dir15, tfp == "15" ? curTrig : f_trigN(ph15, cd15, ago15, fd15), cd15, ts15, zn15, cl15, ph1h, wm15, bn15, bw15, tw15, rs15)
        f_rowW(5, "5m", ph5m, dir5m, tfp == "5" ? curTrig : f_trigN(ph5m, cd5m, ago5m, fd5m), cd5m, ts5m, zn5m, cl5m, ph15, wm5m, bn5m, bw5m, tw5m, rs5m)
        f_starveW(1, nbD, "D")
        f_starveW(2, nb4, "4H")
        f_starveW(3, nb1h, "1H")
        f_starveW(4, nb15, "15m")
        f_starveW(5, nb5m, "5m")
        if not isStdTF
            f_rowW(6, "גרף (" + tfp + ")", phase, msDir, curTrig, armDir, ckTest ? 1 : 0, phase > 0 ? (okZone ? 1 : 0) : -1, chartClB, 0, chartWm, fN, fW, chartTw, rsiV)
        if not tblCompact
            f_cell(0, 8, "הגרף (" + tfp + ") · " + (armDir == 1 ? "✈ לונג חמוש" : armDir == -1 ? "✈ שורט חמוש" : "אין סטאפ") + " · RSI " + f_rsiTxt(rsiV), HDR, armDir != 0 ? color.yellow : TXT, szN)
            f_cell(3, 8, "יחס 1:3 " + (na(ckRR) ? "—" : str.tostring(ckRR, "#.#")) + (ckRRok ? " ✓" : " ✗"), ckRRok ? GRN : color.new(RED, 45), color.white, szN)
            f_cell(5, 8, "סשן " + sesName + (ckSes ? " ✓" : " ✗"), ckSes ? GRN : color.new(RED, 45), color.white, szN)
            f_cell(7, 8, "מיקום " + str.tostring(pdPct) + "% " + (inPrem ? "פרימיום" : "דיסקאונט"), BG, TXT, szN)
            f_cell(9, 8, "AMD " + amdPh, BG2, TXT, szN)
            f_cell(11, 8, "סינרגיה " + (synCnt >= 3 ? "🔥 " : "") + str.tostring(synCnt) + "/4", BG, synCnt >= 3 ? color.yellow : MUT, szN)
            f_cellT(0, 9, "בקטסט " + str.tostring(targetR, "#") + "R · " + btPeriod, HDR, TXT, szN, "סטטיסטיקה על הגרף הנוכחי לפי אסטרטגיה: פגיעות/כניסות · אחוז. בהגדרות: אסטרטגיה, תקופה אחרונה, טווח תאריכים")
            f_cell(3, 9, "✈ טיסה " + str.tostring(fW) + "/" + str.tostring(fN) + " · " + pct(fW, fN), BG, TXT, szN)
            f_cell(5, 9, "כנף " + str.tostring(wW) + "/" + str.tostring(wN) + " · " + pct(wW, wN), BG2, TXT, szN)
            f_cell(7, 9, "OB " + str.tostring(oW) + "/" + str.tostring(oN) + " · " + pct(oW, oN), BG, TXT, szN)
            f_cell(9, 9, "W/M " + str.tostring(wmW) + "/" + str.tostring(wmN) + " · " + pct(wmW, wmN), BG2, TXT, szN)
            f_cell(11, 9, "לונ' " + str.tostring(array.get(sesW, 1)) + "/" + str.tostring(array.get(sesN, 1)) + " · ניו' " + str.tostring(array.get(sesW, 2)) + "/" + str.tostring(array.get(sesN, 2)) + " · אס' " + str.tostring(array.get(sesW, 0)) + "/" + str.tostring(array.get(sesN, 0)), BG, TXT, szS)
            for pr = 8 to 9
                table.merge_cells(t, cx + 0, cy + pr, cx + 2, cy + pr)
                table.merge_cells(t, cx + 3, cy + pr, cx + 4, cy + pr)
                table.merge_cells(t, cx + 5, cy + pr, cx + 6, cy + pr)
                table.merge_cells(t, cx + 7, cy + pr, cx + 8, cy + pr)
                table.merge_cells(t, cx + 9, cy + pr, cx + 10, cy + pr)
                table.merge_cells(t, cx + 11, cy + pr, cx + 12, cy + pr)
        f_cell(0, 7, bosPend, BG2, color.yellow, szS)
        f_cell(1, 7, "", BG2, TXT, szS)
        f_cell(2, 7, "", BG2, TXT, szS)
        f_cell(3, 7, "", BG2, TXT, szS)
        f_cell(4, 7, "", BG2, TXT, szS)
        f_cell(5, 7, smtOn ? "SMT מול " + smtSym : "SMT: אין צמד לנכס הזה", BG2, MUT, szS)
        f_cell(6, 7, "", BG2, TXT, szS)
        f_cell(7, 7, "", BG2, TXT, szS)
        f_cell(8, 7, "", BG2, TXT, szS)
        f_cell(9, 7, "", BG2, TXT, szS)
        f_cell(10, 7, "יום " + dayName, BG2, TXT, szS)
        f_cell(11, 7, "", BG2, TXT, szS)
        table.merge_cells(t, cx + 0, cy + 7, cx + 4, cy + 7)
        table.merge_cells(t, cx + 5, cy + 7, cx + 9, cy + 7)
        table.merge_cells(t, cx + 10, cy + 7, cx + 11, cy + 7)
