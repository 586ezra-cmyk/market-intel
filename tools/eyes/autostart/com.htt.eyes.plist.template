<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  עיניים — LaunchAgent template. install_autostart.command replaces __EYES_DIR__ and __HOME__
  and copies the result to ~/Library/LaunchAgents/com.htt.eyes.plist.
  The server only listens on 127.0.0.1:8770 and idles: it captures nothing until /start.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.htt.eyes</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__EYES_DIR__/eyes_server.py</string>
    <string>--port</string>
    <string>8770</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__EYES_DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HOME__/.local/share/htt-eyes/server.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/share/htt-eyes/server.log</string>
</dict>
</plist>
